---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Offer from '../components/Offer.astro';
import CtaBand from '../components/CtaBand.astro';
import Verify from '../components/Verify.astro';
import { site, whatsappHref } from '../data/site';

import fotoArco from '../assets/talleres/talleres-01-conferencia-arco.jpg';
import fotoSala from '../assets/talleres/talleres-02-sala-amplia.jpg';
import fotoTaller from '../assets/talleres/talleres-03-taller-publico.jpg';
import fotoMesa from '../assets/talleres/talleres-04-mesa-larga.jpg';
import fotoCharla from '../assets/talleres/talleres-05-charla-pantalla.jpg';

/**
 * Galería documental: fotos reales de talleres y conferencias de Melanie.
 * Los pies describen lo que se ve en la pantalla de cada foto; no se nombran organizaciones ni se inventan datos.
 */
const galeria = [
  {
    src: fotoSala,
    alt: 'Melanie, de pie con micrófono frente a un grupo, guía un ejercicio de atención plena proyectado en pantalla',
    caption: 'Ejercicio de atención plena durante una conferencia.',
    shape: 'wide',
  },
  {
    src: fotoTaller,
    alt: 'Vista desde el público: Melanie presenta un taller sobre amor propio frente a una pantalla',
    caption: 'Taller sobre amor propio: romper mitos.',
    shape: 'tall',
  },
  {
    src: fotoCharla,
    alt: 'Melanie, con micrófono de diadema, da una charla junto a una pantalla con el título “Decidir bien no es cuestión de suerte”',
    caption: 'Decidir bien: claridad e inteligencia emocional.',
    shape: 'tall',
  },
  {
    src: fotoMesa,
    alt: 'Un grupo de profesionales sentadas a una mesa larga escucha a Melanie al fondo de la sala',
    caption: 'Encuentro con profesionales de la salud: el peso emocional de cuidar.',
    shape: 'wide',
  },
] as const;

const temas = [
  'Bienestar emocional',
  'Manejo del estrés',
  'Comunicación efectiva',
  'Amor propio y límites',
  'Inteligencia emocional y decisiones',
  'Atención plena',
  'El peso emocional de cuidar a otros',
  'Crianza y redes sociales',
];
---

<Base
  title="Talleres y conferencias de psicología en Puerto Rico · Growing Souls"
  description="Talleres, conferencias y charlas de psicoeducación con la Dra. Melanie Acevedo Vélez para empresas, organizaciones, comunidades y grupos. Presenciales o en línea."
>
  <PageHero
    eyebrow="Talleres y conferencias"
    title="Hablar en grupo de lo que casi nunca se habla."
    subtitle="Talleres, conferencias y charlas de psicoeducación para empresas, organizaciones, comunidades y grupos. Herramientas prácticas, lenguaje claro y la misma seriedad de la consulta."
    image={fotoArco}
    alt="Melanie, con micrófono en mano, habla frente a un grupo durante una conferencia"
    focus="50% 30%"
  />

  <section class="section section--tight">
    <div class="container">
      <SectionHeading eyebrow="Para quién" title="Tres contextos, una misma manera de acompañar." />
      <Offer
        columns={3}
        items={[
          {
            title: 'Empresas y organizaciones',
            text: 'Bienestar emocional, manejo del estrés y comunicación efectiva para equipos que quieren trabajar mejor y cuidarse mientras lo hacen.',
          },
          {
            title: 'Comunidades y grupos',
            text: 'Charlas para asociaciones, grupos de mujeres, familias y comunidades: lo que sentimos, los límites, el amor propio y cómo cuidarnos.',
          },
          {
            title: 'Quienes cuidan a otros',
            text: 'Profesionales de la salud, la educación y el servicio: el peso emocional del trabajo, la sobrecarga y cómo sostenerse sin romperse.',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHeading eyebrow="En la sala" title="Grupos reales, conversaciones reales." />
      <ul class="galeria" role="list">
        {
          galeria.map((foto, i) => (
            <li class:list={['galeria__item', `galeria__item--${foto.shape}`]} data-reveal style={`--reveal-index: ${i + 1}`}>
              <figure class="galeria__figure">
                <div class="galeria__media">
                  <Image
                    src={foto.src}
                    alt={foto.alt}
                    widths={foto.shape === 'wide' ? [640, 960, 1400, 1740] : [480, 720, 960, 1300]}
                    sizes={foto.shape === 'wide' ? '(min-width: 960px) 56vw, 100vw' : '(min-width: 960px) 28vw, 100vw'}
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="galeria__caption small">{foto.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container--narrow temas" data-reveal>
      <SectionHeading eyebrow="Temas" title="Algunos temas que Melanie ha llevado a grupos." />
      <ul class="temas__list" role="list" data-dotlist>
        {temas.map((t) => <li>{t}</li>)}
      </ul>
      <p class="temas__note">
        <Verify note="Aprobación Melanie · temas, públicos y formatos">
          Cada taller se diseña con el grupo: se parte de lo que ese equipo o esa comunidad necesita, no de una charla
          enlatada. Presenciales o en línea, adaptados al tamaño del grupo y al tiempo disponible.
        </Verify>
      </p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container pasos-wrap">
      <SectionHeading eyebrow="Cómo se organiza" title="Tres pasos para llevarlo a tu grupo." />
      <ol class="pasos" role="list">
        <li data-reveal>
          <span class="pasos__n">1</span>
          <h3 class="pasos__title">Conversamos</h3>
          <p>Quién es el grupo, qué está pasando y qué quieren lograr con el encuentro.</p>
        </li>
        <li data-reveal style="--reveal-index: 1">
          <span class="pasos__n">2</span>
          <h3 class="pasos__title">Propuesta</h3>
          <p>Melanie propone tema, formato y duración: taller práctico, conferencia o charla breve.</p>
        </li>
        <li data-reveal style="--reveal-index: 2">
          <span class="pasos__n">3</span>
          <h3 class="pasos__title">Encuentro</h3>
          <p>Se realiza la actividad y, si el grupo lo quiere, se le da continuidad con nuevos temas.</p>
        </li>
      </ol>
      <p class="pasos__wa small" data-reveal style="--reveal-index: 3">
        ¿Prefieres escribir directo? <a href={whatsappHref} rel="noopener">WhatsApp · {site.contact.phone}</a>
      </p>
    </div>
  </section>

  <CtaBand
    title="¿Un taller para tu equipo o tu comunidad?"
    subtitle="Cuéntame sobre el grupo y te respondo con una propuesta a su medida."
    cta={{ label: 'Solicitar información', href: '/agenda/?tipo=taller' }}
    tone="ivory"
  />
</Base>

<style>
  /* Galería: una columna en móvil; en desktop, retícula editorial de tres columnas con piezas anchas y altas. */
  .galeria {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }
  .galeria__figure {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .galeria__media {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--stone);
  }
  .galeria__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .galeria__item--wide .galeria__media {
    aspect-ratio: 3 / 2;
  }
  .galeria__item--tall .galeria__media {
    aspect-ratio: 4 / 5;
  }
  .galeria__caption {
    color: var(--fg-soft);
    text-align: center;
    text-wrap: balance;
  }
  @media (min-width: 640px) and (max-width: 959px) {
    .galeria {
      grid-template-columns: repeat(2, 1fr);
    }
    .galeria__item--wide {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 960px) {
    .galeria {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    .galeria__item--wide {
      grid-column: span 2;
    }
    /* Segunda fila invertida: alta a la izquierda, ancha a la derecha. */
    .galeria__item:nth-child(3) {
      grid-column: 1 / 2;
    }
    .galeria__item:nth-child(4) {
      grid-column: 2 / 4;
    }
    /* La pieza ancha marca la altura de la fila; la alta la llena recortando por el centro. */
    .galeria__item {
      min-height: 0;
    }
    .galeria__figure {
      height: 100%;
      grid-template-rows: 1fr auto;
    }
    .galeria__item--tall .galeria__media {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  /* Temas: lista corrida con punto medio, centrada. */
  .temas__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 0.5rem;
    padding: 0;
    font-family: var(--font-serif);
    font-size: calc(var(--step-body) * 1.2);
    line-height: 1.35;
  }
  .temas__list li {
    position: relative;
    white-space: nowrap;
    padding-inline: 0.7em;
  }
  .temas__list li:not(:first-child)::before {
    content: '·';
    position: absolute;
    left: 0;
    top: 0;
    transform: translateX(-50%);
    color: var(--olive);
  }
  .temas__list li.is-line-start::before {
    display: none;
  }
  .temas__note {
    margin-top: var(--space-5);
    text-align: center;
    max-width: 52ch;
    margin-inline: auto;
    color: var(--fg-soft);
  }

  /* Pasos: número grande en serif, centrados en móvil; tres columnas en desktop. */
  .pasos {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }
  .pasos li {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    text-align: center;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .pasos__n {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-h2);
    line-height: 1;
    color: var(--olive-deep);
  }
  .pasos__title {
    font-size: calc(var(--step-h3) * 0.85);
  }
  .pasos p {
    max-width: 30ch;
    font-size: var(--step-small);
  }
  .pasos__wa {
    margin-top: var(--space-6);
    text-align: center;
    color: var(--fg-soft);
  }
  .pasos__wa a {
    color: var(--olive-deep);
  }
  @media (min-width: 640px) {
    .pasos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }
</style>

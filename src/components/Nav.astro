---
import { nav, cta, site } from '../data/site';
import type { NavItem } from '../data/site';
import Button from './Button.astro';

const path = Astro.url.pathname;
const empieza = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const isCurrent = (item: NavItem) => empieza(item.href) || (item.tambien ?? []).some(empieza);
const items = nav;
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href="/" aria-label={`Growing Souls, ${site.person.shortName}. Inicio`}>
      <img
        class="nav__mark"
        src="/images/brand/isotipo-navy-160.png"
        alt=""
        width="36"
        height="41"
        decoding="async"
      />
      <span class="nav__name">
        <span class="nav__wordmark">Growing Souls</span>
        <span class="nav__sub">{site.person.shortName}</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Principal">
      <ul role="list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined} title={item.short ? item.label : undefined}>
                {item.short ?? item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__cta">
      <Button href={cta.href} variant="primary">{cta.label}</Button>
    </div>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-nav-toggle
    >
      <span class="nav__toggle-label" data-label-open>Menú</span>
      <span class="nav__toggle-label" data-label-close aria-hidden="true">Cerrar</span>
    </button>
  </div>
</header>

<!-- Cajón del menú (móvil y tablet): capa fija bajo la cabecera, no empuja la página ni mueve el scroll. -->
<div id="menu-principal" class="nav__drawer" hidden data-nav-drawer>
    <div class="container nav__drawer-inner">
      <ul role="list" class="nav__drawer-links">
        {
          items.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__drawer-cta" style={`--i: ${items.length}`}>
        <Button href={cta.href} variant="primary">{cta.label}</Button>
      </div>
      <p class="nav__drawer-note small" style={`--i: ${items.length + 1}`}>
        Esta web no es un servicio de emergencias. <a href="/crisis/">Recursos en crisis</a>
      </p>
    </div>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ivory) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-base) var(--ease);
    /* Al cambiar de página, la cabecera se queda quieta y solo la pestaña marcada cambia en fundido (global.css). */
    view-transition-name: gs-cabecera;
  }
  .nav.is-scrolled {
    border-bottom-color: var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--nav-height);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav__mark {
    width: 34px;
    height: auto;
  }
  .nav__name {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .nav__wordmark {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.45rem;
    letter-spacing: 0.01em;
  }
  .nav__sub {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-soft);
    margin-top: 0.15rem;
  }
  .nav__links {
    display: none;
  }
  .nav__links ul {
    display: flex;
    gap: clamp(0.75rem, 1.6vw, 1.75rem);
  }
  .nav__links a {
    font-size: var(--step-small);
    white-space: nowrap;
    text-decoration: none;
    padding: 0.5rem 0;
    background: linear-gradient(var(--olive), var(--olive)) no-repeat left bottom / 0 1px;
    transition: background-size var(--dur-base) var(--ease-in-out);
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    background-size: 100% 1px;
    opacity: 1;
  }
  .nav__cta {
    display: none;
    white-space: nowrap;
  }
  /* "Menú" y "Cerrar" ocupan la misma celda: el botón no cambia de ancho y las palabras se cruzan en fundido. */
  .nav__toggle {
    display: inline-grid;
    align-items: center;
    justify-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--navy);
    border-radius: var(--radius);
    background: transparent;
    font-size: var(--step-small);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      outline-color var(--dur-fast) var(--ease);
  }
  .nav__toggle:hover {
    background: var(--sand);
  }
  .nav__toggle:active {
    transform: scale(0.985);
  }
  .nav__toggle-label {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-base) var(--ease);
  }
  .nav__toggle-label[aria-hidden='true'] {
    opacity: 0;
    transform: translateY(3px);
  }

  /* Cajón del menú: entra con un fundido y un deslizamiento corto, y sus enlaces llegan escalonados;
     al cerrar, todo se desvanece a la vez, algo más rápido. */
  .nav__drawer {
    position: fixed;
    inset: var(--nav-height) 0 0 0;
    z-index: 49;
    border-top: 1px solid var(--line);
    background: var(--ivory);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(calc(var(--nudge) * -1.5));
    transition:
      opacity var(--dur-exit) var(--ease-exit),
      transform var(--dur-exit) var(--ease-exit);
  }
  .nav__drawer.is-open {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-base) var(--ease),
      transform var(--dur-slow) var(--ease);
  }
  .nav__drawer-links li,
  .nav__drawer-cta,
  .nav__drawer-note {
    opacity: 0;
    transform: translateY(var(--nudge));
    transition:
      opacity var(--dur-exit) var(--ease-exit),
      transform var(--dur-exit) var(--ease-exit);
  }
  .nav__drawer.is-open .nav__drawer-links li,
  .nav__drawer.is-open .nav__drawer-cta,
  .nav__drawer.is-open .nav__drawer-note {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-base) var(--ease),
      transform var(--dur-slow) var(--ease);
    transition-delay: calc(80ms + var(--i, 0) * 45ms);
  }
  /* Con el menú abierto, la página no se desplaza por detrás. */
  :global(html.menu-open) {
    overflow: hidden;
  }
  .nav__drawer-inner {
    padding-block: var(--space-6) var(--space-8);
    display: grid;
    gap: var(--space-6);
    justify-items: center;
    text-align: center;
  }
  .nav__drawer-links {
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }
  .nav__drawer-links a {
    display: block;
    padding: 0.5rem 0;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__drawer-links a[aria-current='page'] {
    color: var(--olive-deep);
    font-style: italic;
  }
  .nav__drawer-cta {
    width: min(100%, 20rem);
  }
  .nav__drawer-cta :global(.btn) {
    width: 100%;
  }
  .nav__drawer-note {
    color: var(--fg-soft);
    max-width: 30ch;
  }

  @media (min-width: 1200px) {
    .nav__links,
    .nav__cta {
      display: block;
    }
    .nav__toggle,
    .nav__drawer {
      display: none;
    }
  }
</style>

<script>
  import { reducido, tiempos } from '../scripts/motion';

  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
  const labelOpen = toggle?.querySelector<HTMLElement>('[data-label-open]');
  const labelClose = toggle?.querySelector<HTMLElement>('[data-label-close]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* El cajón existe en el DOM solo mientras se ve: se muestra, entra con su transición y, al cerrar, se oculta
     cuando ya terminó de desvanecerse. */
  let cierre = 0;
  const setOpen = (open: boolean) => {
    if (!toggle || !drawer) return;
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
    labelOpen?.setAttribute('aria-hidden', String(open));
    labelClose?.setAttribute('aria-hidden', String(!open));
    window.clearTimeout(cierre);
    if (open) {
      drawer.hidden = false;
      drawer.getBoundingClientRect();
      drawer.classList.add('is-open');
      drawer.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    } else {
      drawer.classList.remove('is-open');
      cierre = window.setTimeout(
        () => {
          if (!drawer.classList.contains('is-open')) drawer.hidden = true;
        },
        reducido() ? 0 : tiempos().salida + 60,
      );
      toggle.focus({ preventScroll: true });
    }
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  drawer?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false);
  });
</script>

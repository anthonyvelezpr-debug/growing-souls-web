---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { evaluaciones, textos } from '../../data/evaluaciones';
import { site, whatsappHref, cta } from '../../data/site';

export function getStaticPaths() {
  return evaluaciones.map((ev) => ({ params: { id: ev.id }, props: { ev } }));
}

const { ev } = Astro.props;

/* Lo que el runner necesita en el navegador. Sin funciones: se serializa como JSON. */
const config = {
  instrumento: ev,
  textos: { limitaciones: textos.limitaciones, privacidad: textos.privacidad, seguridad: textos.seguridad },
  crisis: site.crisis.lines,
  whatsappHref,
  citaHref: cta.href,
  leadsEndpoint: site.leadsEndpoint,
  privacidadHref: '/privacidad/',
  indiceHref: '/conocete-mejor/',
};
const fuenteCorta = ev.fuente.nombre.split(' · ')[0];
---

<Base
  mobileBar={false}
  title={`${ev.titulo} · Conócete mejor · Growing Souls`}
  description={`Autoevaluación breve sobre ${ev.area.toLowerCase()} (${fuenteCorta}, ${ev.items.length} preguntas, ${ev.duracion}). Orientación educativa, no diagnóstico.`}
>
  <section class="ev section" data-evaluacion>
    <div class="container--narrow ev__wrap">
      <p class="visually-hidden" aria-live="polite" data-live></p>

      <div class="ev__intro" data-intro>
        <p class="ev__crumb small"><a href="/conocete-mejor/">Conócete mejor</a> · {ev.area}</p>
        <h1 class="ev__title">{ev.titulo}</h1>
        <p class="ev__lead">{ev.descripcion}</p>
        <dl class="ev__facts">
          <div>
            <dt>Preguntas</dt>
            <dd>{ev.items.length}</dd>
          </div>
          <div>
            <dt>Tiempo</dt>
            <dd>{ev.duracion}</dd>
          </div>
          <div>
            <dt>Se refiere a</dt>
            <dd>{ev.periodo}</dd>
          </div>
          <div>
            <dt>Instrumento</dt>
            <dd>{fuenteCorta}</dd>
          </div>
        </dl>
        <p class="ev__explora">
          <span class="ev__k">Explora</span>
          {ev.explora}
        </p>
        <div class="ev__nav ev__nav--center" data-start-wrap>
          <Button type="button" variant="primary">Comenzar</Button>
        </div>
        <p class="ev__note small muted">
          Orientación, no diagnóstico; pensada para personas adultas. Tus respuestas no salen de tu dispositivo. Las
          preguntas aparecen como en la versión oficial en español del cuestionario (por eso algunas van en “usted”). Si
          piensas en hacerte daño, llama ahora al <a href="tel:988">988</a>. <a href="/conocete-mejor/#aviso">Más detalles</a>.
        </p>
      </div>

      <div class="ev__stage" data-stage hidden></div>
    </div>
  </section>

  <script type="application/json" id="evaluacion-data" set:html={JSON.stringify(config)} />
  <script>
    import '../../scripts/evaluacion';
  </script>
</Base>

<style is:global>
  /* ----- Marco ----- */
  .ev [hidden] {
    display: none !important;
  }
  .ev__wrap {
    display: grid;
    gap: var(--space-4);
  }
  .ev__intro {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }
  .ev__crumb a {
    color: var(--olive-deep);
  }
  .ev__title {
    font-size: var(--step-h2);
    max-width: 20ch;
    text-wrap: balance;
  }
  .ev__lead {
    max-width: 46ch;
    font-size: calc(var(--step-body) * 1.05);
  }
  .ev__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
    width: min(100%, 28rem);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .ev__facts dt {
    font-size: var(--step-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-soft);
    font-size: 0.78rem;
  }
  .ev__facts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-serif);
    font-size: calc(var(--step-body) * 1.2);
  }
  .ev__explora {
    max-width: 40ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: calc(var(--step-body) * 1.08);
  }
  .ev__k {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-deep);
    margin-right: 0.35em;
  }
  .ev__note {
    max-width: 52ch;
  }
  .ev__note a {
    color: var(--olive-deep);
  }

  /* ----- Escenario de preguntas ----- */
  .ev__stage {
    display: grid;
    gap: var(--space-4);
    min-height: 24rem;
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms var(--ease),
      transform 180ms var(--ease);
  }
  .ev__stage.is-leaving {
    opacity: 0;
    transform: translateY(6px);
  }
  .ev__progress {
    height: 2px;
    background: var(--line);
    border-radius: 1px;
    overflow: hidden;
  }
  .ev__progress-bar {
    display: block;
    height: 100%;
    background: var(--olive);
    transition: width 300ms var(--ease);
  }
  .ev__count {
    text-align: center;
    margin-top: calc(var(--space-2) * -1);
  }
  .ev__count + .ev__hint {
    margin-top: calc(var(--space-3) * -1);
  }
  .ev__fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .ev__question {
    font-family: var(--font-serif);
    font-size: var(--step-h3);
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
    max-width: 26ch;
    margin-inline: auto;
    padding: 0;
  }
  .ev__question:focus {
    outline: none;
  }
  .ev__opciones {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .ev__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .ev__opcion {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--stone);
    border-radius: var(--radius);
    background: var(--ivory);
    font-size: var(--step-small);
    text-align: center;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .ev__opcion:hover {
    border-color: var(--olive);
    background: var(--sand);
  }
  .ev__radio:checked + .ev__opcion {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--ivory);
  }
  .ev__radio:focus-visible + .ev__opcion {
    outline: 2px solid var(--olive-deep);
    outline-offset: 3px;
  }
  .ev__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .ev__nav--center {
    justify-content: center;
  }
  .ev__back,
  .ev__link {
    border: 0;
    background: none;
    padding: 0.5rem 0;
    font: inherit;
    font-size: var(--step-small);
    color: var(--olive-deep);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    cursor: pointer;
  }
  .ev__hint {
    text-align: center;
    max-width: 48ch;
    margin-inline: auto;
  }

  /* ----- Seguridad ----- */
  .ev__safety {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--olive);
    border-radius: var(--radius);
    background: var(--sand);
  }
  .ev__safety--result {
    margin-bottom: var(--space-2);
  }
  .ev__safety-title {
    font-size: var(--step-h3);
  }
  .ev__safety-title:focus {
    outline: none;
  }
  .ev__safety-text,
  .ev__safety-close {
    max-width: 48ch;
  }
  .ev__crisis {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    width: 100%;
  }
  .ev__crisis-item {
    display: grid;
    gap: 0.2rem;
    justify-items: center;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ivory);
  }
  .ev__crisis-number {
    font-family: var(--font-serif);
    font-size: var(--step-h3);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1.1;
    text-decoration: none;
    color: var(--navy);
  }
  .ev__crisis-label {
    color: var(--fg-soft);
  }
  @media (min-width: 640px) {
    .ev__crisis {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ----- Datos ----- */
  .ev__form {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }
  .ev__form-title {
    font-size: var(--step-h3);
  }
  .ev__form-title:focus {
    outline: none;
  }
  .ev__form-text {
    max-width: 48ch;
  }
  .ev__fields {
    display: grid;
    gap: var(--space-3);
    width: min(100%, 30rem);
    text-align: left;
  }
  .ev__field {
    display: grid;
    gap: 0.4rem;
  }
  .ev__field label,
  .ev__check label {
    font-size: var(--step-small);
  }
  .ev__field label {
    font-weight: 500;
  }
  .ev__field input {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--stone);
    border-radius: var(--radius);
    background: var(--ivory);
    color: var(--fg);
    font: inherit;
  }
  .ev__field input:focus {
    outline: none;
    border-color: var(--olive-deep);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--olive) 25%, transparent);
  }
  .ev__field input[aria-invalid='true'] {
    border-color: var(--rose-deep);
  }
  .ev__check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
  }
  .ev__check input {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.25rem;
    accent-color: var(--navy);
  }
  .ev__check .ev__error {
    grid-column: 1 / -1;
  }
  .ev__check a {
    color: var(--olive-deep);
  }
  .ev__error {
    font-size: var(--step-small);
    color: var(--rose-deep);
  }
  .ev__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .ev__privacy {
    max-width: 52ch;
  }

  /* ----- Resultado ----- */
  .ev__result {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }
  .ev__result-title {
    font-size: var(--step-h2);
    max-width: 22ch;
    text-wrap: balance;
  }
  .ev__result-title:focus {
    outline: none;
  }
  .ev__score {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    width: min(100%, 30rem);
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sand);
  }
  .ev__score-num {
    font-family: var(--font-serif);
    line-height: 1;
  }
  .ev__score-big {
    font-size: var(--step-display);
    font-variant-numeric: lining-nums;
  }
  .ev__score-max {
    font-style: italic;
    font-size: calc(var(--step-body) * 1.1);
    color: var(--fg-soft);
  }
  .ev__score-label {
    font-size: var(--step-small);
  }
  .ev__scale {
    position: relative;
    width: 100%;
    padding-top: 0.6rem;
  }
  .ev__segs {
    display: flex;
    gap: 2px;
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
  }
  .ev__seg {
    display: block;
    height: 100%;
    background: var(--stone);
  }
  .ev__seg.is-current.ev__seg--bien {
    background: var(--olive);
  }
  .ev__seg.is-current.ev__seg--leve {
    background: color-mix(in srgb, var(--olive) 70%, var(--rose));
  }
  .ev__seg.is-current.ev__seg--medio {
    background: var(--rose);
  }
  .ev__seg.is-current.ev__seg--alto {
    background: var(--rose-deep);
  }
  .ev__marker {
    position: absolute;
    top: 0;
    width: 2px;
    height: 1.3rem;
    background: var(--navy);
    transform: translateX(-50%);
    border-radius: 1px;
  }
  .ev__block {
    display: grid;
    gap: var(--space-2);
    max-width: 52ch;
  }
  .ev__block h3 {
    font-size: calc(var(--step-h3) * 0.85);
  }
  .ev__block--limits p {
    color: var(--fg-soft);
    font-size: var(--step-small);
  }
  .ev__recs {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .ev__recs li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--step-small);
  }
  .ev__recs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.8rem;
    height: 1px;
    background: var(--olive);
  }
  .ev__callout {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    width: 100%;
    padding: var(--space-4);
    border: 1px solid var(--olive);
    border-radius: var(--radius);
    background: var(--sand);
  }
  .ev__callout p {
    max-width: 48ch;
  }
  .ev__callout--soft {
    border-color: var(--line);
    background: transparent;
  }
  .ev__note a,
  .ev__again a {
    color: var(--olive-deep);
  }
  .ev__source {
    max-width: 56ch;
  }
</style>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Triptych from '../components/Triptych.astro';
import ArchPhoto from '../components/ArchPhoto.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Process from '../components/Process.astro';
import Offer from '../components/Offer.astro';
import Areas from '../components/Areas.astro';
import ProgressReveal from '../components/ProgressReveal.astro';
import Manifesto from '../components/Manifesto.astro';
import ServiceCard from '../components/ServiceCard.astro';
import JournalCard from '../components/JournalCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import Verify from '../components/Verify.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { isPreview } from '../data/site';
import { ejercicios } from '../data/ejercicios';

/* Tres ejercicios de profundidad en la portada, más la puerta a los cuestionarios validados. */
const destacados = ['ochenta', 'frases', 'carta'].map((id) => ejercicios.find((e) => e.id === id)!);

import fotoHero from '../assets/melanie/05-mirada-abajo-cerca.jpg';
import fotoTaller from '../assets/talleres/talleres-06-portada-arco.jpg';
import fotoRetrato from '../assets/melanie/06-banquillo-recorte.png';
import fotoOlivo from '../assets/melanie/03-olivo-cerca.jpg';

/* La foto del hero es el elemento más grande de la primera pantalla: se anuncia en el head para que cargue primero. */
const heroImg = await getImage({ src: fotoHero, widths: [480, 720, 960, 1200], format: 'webp', quality: 82 });
const heroSizes = '(min-width: 960px) 40vw, (min-width: 640px) 416px, 336px';

const posts = (await getCollection('journal', ({ data }) => isPreview || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base
  title="Growing Souls · Dra. Melanie Acevedo Vélez, Psicóloga Clínica"
  description="Un espacio seguro para sentir, comprender y crecer. Psicoterapia individual y de pareja en Puerto Rico, presencial y en línea."
>
  <link slot="head" rel="preload" as="image" imagesrcset={heroImg.srcSet.attribute} imagesizes={heroSizes} fetchpriority="high" />
  <Hero
    title="Un espacio seguro para sentir, comprender y crecer."
    subtitle="Psicoterapia desde la evidencia, la empatía y nuestra humanidad."
    signature="Dra. Melanie Acevedo Vélez, PsyD · Psicóloga Clínica · Puerto Rico"
    primary={{ label: 'Comienza tu proceso', href: '/agenda/' }}
    secondary={{ label: 'Conoce a Melanie', href: '/melanie/' }}
    image={fotoHero}
    alt="Melanie sonríe mirando hacia abajo, sentada en el piso entre hojas de olivo, con las manos sobre un modelo de cerebro"
    caption="Dra. Melanie Acevedo Vélez · Psicóloga Clínica"
    focus="50% 30%"
  />

  <Statement
    title="No tienes que llegar a terapia teniendo todas las respuestas."
    subtitle="A veces, llegar es el primer acto de valentía."
  />

  <section class="section section--tight">
    <div class="container">
      <SectionHeading eyebrow="Cómo podemos trabajar" title="Tres maneras de empezar." />
      <ServiceCard
        services={[
          {
            title: 'Terapia individual',
            text: 'Para lo que llevas contigo, lo que vives con otros y lo que la vida te está pidiendo ahora.',
            href: '/terapia-individual/',
            label: 'Conoce la terapia individual',
          },
          {
            title: 'Terapia de pareja',
            text: 'Amarnos no significa automáticamente saber relacionarnos.',
            href: '/parejas/',
            label: 'Hablemos de relaciones',
          },
          {
            title: 'Talleres y conferencias',
            text: 'Psicoeducación para empresas, organizaciones, comunidades y grupos.',
            href: '/talleres-y-conferencias/',
            label: 'Conoce los talleres',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--sand about">
    <div class="container about__grid">
      <div class="about__photos">
        <ArchPhoto
          src={fotoRetrato}
          alt="Melanie sentada en un banquillo de madera, sonriendo hacia la cámara"
          focus="50% 50%"
          fill="ivory"
          sizes="(min-width: 960px) 34vw, (min-width: 640px) 60vw, 100vw"
        />
      </div>
      <div class="about__text" data-reveal style="--reveal-index: 1">
        <p class="eyebrow">Conoce a Melanie</p>
        <h2>Antes de ser psicóloga, soy persona.</h2>
        <p>
          <Verify note="Aprobación Melanie">
            Mi manera de hacer terapia no salió solo de los libros. Salió también de lo que he vivido: de ser
            puertorriqueña, de las personas que me han enseñado a escuchar y de mis propias preguntas. La universidad
            me dio estructura, teoría y evidencia. Lo que pongo en cada sesión, además de eso, es humanidad.
          </Verify>
        </p>
        <div class="about__cta">
          <Button href="/melanie/" variant="link">Conoce mi historia</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Mi enfoque" title="Crecer no siempre significa convertirte en otra persona.">
        <p class="lead">
          Muchas veces significa comprender quién eres, reconciliarte con partes de tu historia, soltar lo que ya no
          te sirve y volver a ti con más conciencia. Ese proceso tiene su propio orden, y no hay que apurarlo.
        </p>
      </SectionHeading>
      <Process />
      <Offer
        items={[
          {
            title: 'Validación emocional',
            text: 'Un lugar donde lo que sientes puede reconocerse y comprenderse sin juicio inmediato.',
          },
          {
            title: 'Acompañamiento',
            text: 'No camino delante de ti diciéndote hacia dónde ir. Camino a tu lado mientras descubres hacia dónde quieres dirigirte.',
          },
          {
            title: 'Psicoeducación',
            text: 'Entender lo que pasa por dentro te da herramientas para responder de otra manera.',
          },
          {
            title: 'Espacio seguro',
            text: 'Aquí puedes ser, sentir, hablar, callar, preguntar y ser vulnerable. Nada de eso hay que justificarlo.',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHeading eyebrow="Áreas de acompañamiento" title="Lo que traes a terapia no tiene que tener nombre todavía." />
      <Areas
        areas={[
          {
            title: 'Tú contigo',
            topics: ['Autoaceptación', 'Culpa', 'Perdón', 'Diálogo interno', 'Valores', 'Identidad', 'Vulnerabilidad', 'Emociones'],
            href: '/terapia-individual/#tu-contigo',
          },
          {
            title: 'Tú con otros',
            topics: ['Pareja', 'Comunicación', 'Límites', 'Conflictos', 'Patrones relacionales', 'Conexión', 'Responsabilidad'],
            href: '/terapia-individual/#tu-con-otros',
          },
          {
            title: 'Tú frente a la vida',
            topics: ['Cambios', 'Pérdidas', 'Estrés', 'Ansiedad', 'Transiciones', 'Burnout', 'Experiencias difíciles'],
            href: '/terapia-individual/#tu-frente-a-la-vida',
          },
        ]}
      />
      <div class="areas-cta" data-reveal>
        <Button href="/como-trabajo/" variant="link">Explora cómo trabajo</Button>
      </div>
    </div>
  </section>

  <section class="section conoce">
    <div class="container">
      <SectionHeading eyebrow="Conócete mejor" title="Hay preguntas que nadie te hace. Aquí te las haces tú.">
        <p class="lead">
          Ejercicios de profundidad, de los que se usan en terapia, para descubrir lo que todavía no has puesto en
          palabras. Y cuatro cuestionarios validados para saber cómo estás. Gratis, privados y sin diagnósticos.
        </p>
      </SectionHeading>
      <ul class="conoce__grid" role="list">
        {
          destacados.map((ej, i) => (
            <li data-reveal style={`--reveal-index: ${i + 1}`}>
              <a class="conoce__card" href={`/conocete-mejor/ejercicios/${ej.id}/`}>
                <span class="conoce__eyebrow">{ej.camino}</span>
                <span class="conoce__area">{ej.titulo}</span>
                <span class="conoce__sub small">{ej.subtitulo}</span>
                <span class="conoce__meta small muted">{ej.duracion.replace('minutos', 'min')} · escribes</span>
                <span class="conoce__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
        <li data-reveal style="--reveal-index: 4">
          <a class="conoce__card conoce__card--sand" href="/conocete-mejor/#cuestionarios">
            <span class="conoce__eyebrow">Cuestionarios validados</span>
            <span class="conoce__area">¿Cómo te has estado sintiendo?</span>
            <span class="conoce__sub small">Bienestar, ánimo, ansiedad y estrés, con los instrumentos que usan los profesionales.</span>
            <span class="conoce__meta small muted">4 cuestionarios · 3 min cada uno</span>
            <span class="conoce__go" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
      <div class="conoce__cta" data-reveal>
        <Button href="/conocete-mejor/" variant="link">Ver los diez ejercicios y los cuestionarios</Button>
      </div>
    </div>
  </section>

  <ProgressReveal />

  <Manifesto eyebrow="Manifiesto" title="Un espacio seguro para sentir, comprender y crecer." cta={{ label: 'Conoce Growing Souls', href: '/melanie/#growing-souls' }}>
    <p>
      <Verify note="Aprobación Melanie · origen del nombre pendiente de entrevista">
        Growing Souls nació de una convicción: la psicología puede ser rigurosa y profundamente humana al mismo
        tiempo. Aquí no hay nada que reparar. Hay algo que comprender. Vengo a acompañarte mientras entiendes tu
        historia, reconoces tus patrones y decides, con tus propios valores, hacia dónde quieres crecer.
      </Verify>
    </p>
  </Manifesto>

  <Triptych
    image={fotoOlivo}
    alt="Melanie sentada junto a un olivo, con las manos sobre un modelo de cerebro, sonriendo"
    focus="50% 40%"
    quote="Aquí no hay nada que reparar. Hay algo que comprender."
    quoteCite="Mi manera de hacer terapia"
    eyebrow="Evidencia y humanidad"
    title="La evidencia da estructura. La humanidad da conexión."
    cta={{ label: 'Explora cómo trabajo', href: '/como-trabajo/' }}
    tone="ivory"
  >
    <p>
      Trabajo con enfoques con respaldo científico (ACT, EFT y CBT), explicados primero como se viven y después por su
      nombre. Y con algo que ningún manual incluye: alguien que te escucha con respeto, sin apurarte y sin decidir por ti.
    </p>
  </Triptych>

  <section class="section section--sand talleres" id="talleres">
    <div class="container talleres__grid">
      <div class="talleres__figure">
        <ArchPhoto
          src={fotoTaller}
          alt="Retrato de Melanie, sonriente, durante su taller sobre amor propio; detrás, su presentación en pantalla"
          focus="50% 30%"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 960px) 34vw, (min-width: 640px) 60vw, 520px"
        />
      </div>
      <div class="talleres__text" data-reveal style="--reveal-index: 1">
        <p class="eyebrow">Talleres y conferencias</p>
        <h2>Lo que se trabaja en sesión también se puede aprender en grupo.</h2>
        <p>
          <Verify note="Aprobación Melanie · temas, públicos y formatos de los talleres por confirmar">
            Melanie ofrece talleres, conferencias y charlas de psicoeducación para empresas, organizaciones,
            comunidades y grupos: bienestar emocional, manejo del estrés, comunicación, límites y amor propio, con
            herramientas prácticas y el mismo rigor de la consulta. Presenciales o en línea.
          </Verify>
        </p>
        <div class="talleres__cta">
          <Button href="/talleres-y-conferencias/" variant="primary">Conoce los talleres</Button>
          <Button href="/agenda/?tipo=taller" variant="secondary">Solicitar información</Button>
        </div>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHeading eyebrow="Growing Journal" title="Para sentir y pensar.">
            <p class="lead">
              Reflexiones sobre relaciones, emociones, culpa, límites y las historias que nos contamos. Sin
              diagnósticos por Instagram y sin promesas.
            </p>
          </SectionHeading>
          <div class="journal-grid">
            {posts.map((post, i) => (
              <JournalCard
                href={`/journal/${post.id}/`}
                title={post.data.title}
                description={post.data.description}
                tema={post.data.tema}
                readingTime={post.data.readingTime}
                draft={post.data.draft}
                index={i}
              />
            ))}
          </div>
          <div class="areas-cta" data-reveal>
            <Button href="/journal/" variant="link">Leer el Journal</Button>
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    title="Tal vez llevas algún tiempo pensando en comenzar."
    subtitle="Cuando sientas que es el momento de hablar, aquí hay un espacio para escucharte."
    cta={{ label: 'Solicitar una cita', href: '/agenda/' }}
  />
</Base>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .about__photos {
    width: min(100%, 22rem);
    margin-inline: auto;
  }
  .about__text {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }
  .about__text h2 {
    max-width: 16ch;
  }
  .about__text p:not(.eyebrow) {
    max-width: 44ch;
  }
  .about__cta {
    margin-top: var(--space-1);
  }
  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
    .about__photos {
      width: min(100%, 27rem);
      justify-self: center;
    }
    .about__text {
      justify-items: start;
      text-align: left;
    }
    .about__text p:not(.eyebrow) {
      max-width: var(--measure);
    }
  }
  /* Talleres: arco a la izquierda y texto a la derecha en desktop; centrado en móvil y tablet. */
  .talleres__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .talleres__figure {
    width: min(100%, 22rem);
    margin-inline: auto;
  }
  .talleres__text {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }
  .talleres__text h2 {
    max-width: 21ch;
  }
  .talleres__text p:not(.eyebrow) {
    max-width: 44ch;
  }
  .talleres__cta {
    margin-top: var(--space-1);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  @media (min-width: 960px) {
    .talleres__cta {
      justify-content: flex-start;
    }
  }
  @media (min-width: 960px) {
    .talleres__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
    .talleres__figure {
      width: min(100%, 26rem);
    }
    .talleres__text {
      justify-items: start;
      text-align: left;
    }
    .talleres__text p:not(.eyebrow) {
      max-width: var(--measure);
    }
  }
  /* Conócete mejor: tres ejercicios y la puerta a los cuestionarios; 1 columna en móvil, 2 en tablet, 4 en desktop. */
  .conoce__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding: 0;
  }
  .conoce__card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ivory);
    text-align: left;
    text-decoration: none;
    color: var(--fg);
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .conoce__card--sand {
    background: var(--sand);
  }
  .conoce__card:hover {
    border-color: var(--olive);
    background: var(--sand);
  }
  .conoce__eyebrow {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-deep);
  }
  .conoce__area {
    font-family: var(--font-serif);
    font-size: calc(var(--step-h3) * 0.85);
    line-height: 1.15;
    text-wrap: balance;
  }
  .conoce__sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: calc(var(--step-body) * 1.02);
    line-height: 1.4;
  }
  .conoce__meta {
    margin-top: 0.2rem;
  }
  .conoce__go {
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-serif);
    color: var(--olive-deep);
    transition: transform var(--dur-fast) var(--ease);
  }
  .conoce__card:hover .conoce__go {
    transform: translateX(3px);
  }
  .conoce__cta {
    margin-top: var(--space-5);
    display: grid;
    justify-items: center;
  }
  @media (min-width: 640px) {
    .conoce__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
  }
  @media (min-width: 1100px) {
    .conoce__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .areas-cta {
    margin-top: var(--space-6);
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .journal-grid {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 960px) {
    .journal-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
</style>

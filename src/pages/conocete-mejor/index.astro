---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import { evaluaciones, textos } from '../../data/evaluaciones';
import { site } from '../../data/site';
---

<Base
  title="Conócete mejor · Autoevaluaciones de bienestar emocional · Growing Souls"
  description="Herramientas breves y gratuitas de autoevaluación sobre bienestar, ánimo, ansiedad y estrés, basadas en instrumentos de uso libre. Orientación, no diagnóstico."
>
  <PageHero
    eyebrow="Conócete mejor"
    title="¿Cómo te has estado sintiendo?"
    subtitle="Herramientas breves para mirar con calma cómo estás, basadas en cuestionarios que usan profesionales de la salud mental. Gratuitas, privadas y sin diagnósticos."
  />

  <section class="section section--tight">
    <div class="container">
      <ul class="colec" role="list">
        {
          evaluaciones.map((ev, i) => (
            <li class="colec__card" data-reveal style={`--reveal-index: ${i + 1}`}>
              <p class="eyebrow">{ev.area}</p>
              <h2 class="colec__title">{ev.titulo}</h2>
              <p class="colec__text">{ev.descripcion}</p>
              <p class="colec__explora small">
                <span class="colec__k">Explora</span> {ev.explora}
              </p>
              <p class="colec__meta small muted" data-dotlist>
                <span>{ev.items.length} preguntas</span>
                <span>{ev.duracion}</span>
                <span>{ev.fuente.nombre.split(' · ')[0]}</span>
              </p>
              <a class="btn btn--primary colec__btn" href={`/conocete-mejor/${ev.id}/`}>
                Comenzar
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand" id="aviso">
    <div class="container--narrow aviso" data-reveal>
      <SectionHeading eyebrow="Antes de empezar" title="Lo que estas herramientas son, y lo que no." />
      <ul class="aviso__list" role="list">
        <li>
          <h3>Orientación, no diagnóstico</h3>
          <p>{textos.aviso}</p>
        </li>
        <li>
          <h3>Privadas de verdad</h3>
          <p>{textos.privacidad}</p>
        </li>
        <li>
          <h3>Si estás en crisis</h3>
          <p>
            Estas herramientas no son para emergencias. Si piensas en hacerte daño, llama ahora:{' '}
            {site.crisis.lines.map((l, i) => (
              <>
                <a href={l.href}>{l.number}</a>
                {i < site.crisis.lines.length - 1 ? ' · ' : '. '}
              </>
            ))}
            <a href="/crisis/">Más recursos</a>.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container pasos-wrap">
      <SectionHeading eyebrow="Cómo funciona" title="Tres minutos, a tu ritmo." />
      <ol class="pasos" role="list">
        <li data-reveal>
          <span class="pasos__n">1</span>
          <p>Elige una herramienta. Cada una mira un área distinta de cómo estás.</p>
        </li>
        <li data-reveal style="--reveal-index: 1">
          <span class="pasos__n">2</span>
          <p>Responde pregunta a pregunta, con calma. Puedes volver atrás en cualquier momento.</p>
        </li>
        <li data-reveal style="--reveal-index: 2">
          <span class="pasos__n">3</span>
          <p>Recibe tu resultado con una explicación clara, sus límites y algunas ideas para cuidarte.</p>
        </li>
      </ol>
    </div>
  </section>

  <CtaBand
    title="Un cuestionario abre una puerta. Hablar la cruza."
    subtitle="Si quieres conversar sobre lo que viste aquí, o sobre lo que no cabe en una puntuación, aquí hay un espacio para escucharte."
    tone="sand"
  />
</Base>

<style>
  /* Colección: una columna en móvil, dos en tablet y desktop. Tarjetas como las de Áreas. */
  .colec {
    display: grid;
    gap: var(--space-3);
    padding: 0;
  }
  .colec__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-5) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ivory);
  }
  .colec__title {
    font-size: var(--step-h3);
    text-wrap: balance;
    max-width: 18ch;
  }
  .colec__text {
    font-size: var(--step-small);
    max-width: 38ch;
  }
  .colec__explora {
    max-width: 36ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: calc(var(--step-body) * 1.05);
  }
  .colec__k {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--step-small);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--olive-deep);
    margin-right: 0.3em;
  }
  .colec__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 0.25rem;
  }
  .colec__meta span {
    position: relative;
    white-space: nowrap;
    padding-inline: 0.6em;
  }
  .colec__meta span:not(:first-child)::before {
    content: '·';
    position: absolute;
    left: 0;
    top: 0;
    transform: translateX(-50%);
    color: var(--olive);
  }
  .colec__meta span.is-line-start::before {
    display: none;
  }
  .colec__btn {
    margin-top: auto;
  }
  .colec__meta {
    margin-bottom: var(--space-2);
  }
  @media (min-width: 640px) {
    .colec {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
    .colec__card {
      padding: var(--space-6) var(--space-4);
    }
  }
  @media (min-width: 960px) {
    .colec__card {
      padding: var(--space-8) var(--space-5);
    }
  }

  /* Aviso: tres bloques con regla superior, centrados en móvil, en columnas desde tablet. */
  .aviso__list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }
  .aviso__list li {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .aviso__list h3 {
    font-size: calc(var(--step-h3) * 0.8);
  }
  .aviso__list p {
    font-size: var(--step-small);
    color: var(--fg);
  }
  @media (min-width: 640px) {
    .aviso__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    .aviso__list li {
      text-align: left;
    }
  }

  /* Pasos (misma gramática que en Talleres). */
  .pasos {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }
  .pasos li {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    text-align: center;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .pasos__n {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-h2);
    line-height: 1;
    color: var(--olive-deep);
  }
  .pasos p {
    max-width: 30ch;
    font-size: var(--step-small);
  }
  @media (min-width: 640px) {
    .pasos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }
</style>

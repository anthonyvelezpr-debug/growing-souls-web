---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Accordion from '../components/Accordion.astro';
import CtaBand from '../components/CtaBand.astro';
import Verify from '../components/Verify.astro';

import fotoLaptop from '../assets/melanie/02-laptop-cerca.jpg';

const faq = [
  {
    q: '¿Funciona igual que la terapia presencial?',
    a: 'Para muchas personas, sí. Lo que más importa es que tengas privacidad y te sientas en confianza. Si en algún momento sentimos que la modalidad no te está ayudando, lo hablamos.',
  },
  {
    q: '¿Qué pasa si se cae la conexión?',
    a: 'Volvemos a conectarnos. Si no es posible, reprogramamos la sesión.',
  },
  {
    q: '¿Puedo alternar presencial y virtual?',
    a: 'En muchos casos sí. Lo coordinamos según tu situación.',
  },
  {
    q: '¿Cómo pago?',
    a: 'Lo coordinamos al confirmar la cita.',
  },
];

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Psicóloga online en Puerto Rico · Oficina virtual Growing Souls"
  description="Sesiones de psicoterapia por videollamada para personas en Puerto Rico. Cómo funciona, privacidad y qué necesitas."
  jsonLd={[faqJsonLd]}
>
  <PageHero
    eyebrow="Oficina virtual"
    title="Tu espacio seguro también puede encontrarte donde estés."
    subtitle="La terapia en línea no es “la alternativa cuando no puedes venir”. Es una manera legítima de hacer terapia, con la misma presencia y la misma confidencialidad."
    image={fotoLaptop}
    alt="Melanie sonríe sentada en el piso con su laptop, con notas de recordatorio pegadas en la tapa"
    focus="50% 50%"
    ratio="2 / 3"
  />

  <section class="section section--tight">
    <div class="container steps-wrap">
      <SectionHeading eyebrow="Cómo funciona" title="Cuatro pasos, sin complicaciones." />
      <ol class="steps" role="list">
        <li data-reveal><span class="steps__n">1</span><p>Solicitas una cita y eliges la modalidad virtual.</p></li>
        <li data-reveal style="--reveal-index: 1"><span class="steps__n">2</span><p>Recibes el enlace de la sesión y unas indicaciones breves.</p></li>
        <li data-reveal style="--reveal-index: 2"><span class="steps__n">3</span><p>Buscas un lugar privado y tranquilo, con conexión estable.</p></li>
        <li data-reveal style="--reveal-index: 3"><span class="steps__n">4</span><p>Nos vemos a la hora acordada. La sesión dura lo mismo que una presencial.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container--narrow prose" data-reveal>
      <h2>Lo que necesitas</h2>
      <ul>
        <li>Un teléfono, tableta o computadora con cámara y micrófono.</li>
        <li>Conexión estable.</li>
        <li>Audífonos si compartes el espacio.</li>
        <li>Un lugar donde puedas hablar con libertad.</li>
      </ul>

      <h2>Privacidad</h2>
      <p>
        <Verify note="Revisión clínica y legal: plataforma, confidencialidad, HIPAA">
          Las sesiones se realizan por videollamada, en privado, y lo que hablamos tiene la misma confidencialidad
          que en la oficina.
        </Verify>
      </p>

      <h2>Para quién</h2>
      <p>
        <Verify note="Verificar: jurisdicción de la licencia">
          Atiendo por videollamada a personas que se encuentran en Puerto Rico.
        </Verify>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container--narrow">
      <SectionHeading eyebrow="Preguntas frecuentes" title="Lo que suelen preguntarme antes de empezar." />
      <Accordion items={faq} />
    </div>
  </section>

  <CtaBand
    title="Tal vez llevas algún tiempo pensando en comenzar."
    subtitle="Cuando sientas que es el momento de hablar, aquí hay un espacio para escucharte."
    cta={{ label: 'Solicitar una cita virtual', href: '/agenda/' }}
    tone="sand"
  />
</Base>

<style>
  .steps {
    display: grid;
    gap: var(--space-3);
    padding: 0;
  }
  /* Móvil y tablet: número sobre el texto, centrado. Desktop: cuatro columnas, alineadas a la izquierda. */
  .steps li {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    text-align: center;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .steps__n {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-h2);
    line-height: 1;
    color: var(--olive-deep);
  }
  .steps p {
    max-width: 30ch;
  }
  @media (min-width: 640px) and (max-width: 959px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }
  @media (min-width: 960px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
    .steps li {
      justify-items: start;
      text-align: left;
      padding-top: var(--space-3);
    }
  }
</style>

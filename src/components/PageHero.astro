---
import type { ImageMetadata } from 'astro';
import ArchPhoto from './ArchPhoto.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  alt?: string;
  focus?: string;
  zoom?: number;
  ratio?: string;
  /** Color de fondo dentro del arco para retratos sin fondo (PNG con transparencia). */
  fill?: 'ivory' | 'sand';
  caption?: string;
  tone?: 'ivory' | 'sand';
  /** Anchos generados y `sizes` de la foto; por defecto, los del arco de cabecera. Permiten servir más resolución a una foto concreta. */
  widths?: number[];
  sizes?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  image,
  alt = '',
  focus = '50% 20%',
  zoom = 1,
  ratio = '4 / 5',
  fill,
  caption,
  tone = 'ivory',
  widths = [480, 720, 960, 1200],
  sizes = '(min-width: 960px) 34vw, (min-width: 640px) 60vw, 100vw',
} = Astro.props;
---

<section class:list={['phero', `phero--${tone}`, { 'phero--with-image': !!image }]}>
  <div class="container phero__grid">
    <div class="phero__text">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h1 class="phero__title" data-reveal style="--reveal-index: 1">{title}</h1>
      {
        subtitle && (
          <p class="phero__sub" data-reveal style="--reveal-index: 2">
            {subtitle}
          </p>
        )
      }
      <slot />
    </div>
    {
      image && (
        <div class="phero__photo">
          <ArchPhoto src={image} alt={alt} focus={focus} zoom={zoom} ratio={ratio} fill={fill} caption={caption} loading="eager" widths={widths} sizes={sizes} />
        </div>
      )
    }
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .phero--sand {
    background: var(--sand);
  }
  .phero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .phero__text {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }
  .phero__title {
    max-width: 17ch;
  }
  .phero:not(.phero--with-image) .phero__title {
    max-width: 22ch;
  }
  .phero__sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: calc(var(--step-h3) * 0.9);
    max-width: 34ch;
  }
  @media (min-width: 960px) {
    .phero__text {
      justify-items: start;
      text-align: left;
    }
    .phero--with-image .phero__text {
      justify-items: start;
    }
    .phero:not(.phero--with-image) .phero__text {
      justify-items: center;
      text-align: center;
      margin-inline: auto;
    }
  }
  .phero__photo {
    width: min(100%, 22rem);
    margin-inline: auto;
  }
  @media (min-width: 960px) {
    .phero--with-image .phero__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
    .phero__photo {
      width: min(100%, 26rem);
      justify-self: center;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Statement from '../components/Statement.astro';
import Button from '../components/Button.astro';
---

<Base title="Página no encontrada · Growing Souls" description="Esta página no está aquí." noindex={true}>
  <Statement as="h1" title="Esta página no está aquí." subtitle="Pero tú sí.">
    <div class="actions">
      <Button href="/" variant="primary">Volver al inicio</Button>
      <Button href="/journal/" variant="secondary">Explorar el Journal</Button>
    </div>
  </Statement>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-2);
  }
</style>

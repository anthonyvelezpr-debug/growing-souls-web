---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import ArchPhoto from './ArchPhoto.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  signature?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  imageDesktop: ImageMetadata;
  imageMobile?: ImageMetadata;
  alt: string;
  caption?: string;
  /** Posición del recorte en desktop, p. ej. "50% 30%" */
  focusDesktop?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  signature,
  primary,
  secondary,
  imageDesktop,
  imageMobile,
  alt,
  caption,
  focusDesktop = '50% 30%',
} = Astro.props;

const mobileSrc = imageMobile ?? imageDesktop;
const mobile = await getImage({ src: mobileSrc, widths: [480, 720, 960], format: 'webp', quality: 80 });
---

<section class="hero">
  <div class="hero__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      signature && (
        <p class="hero__signature">
          {signature.split(' · ').map((part, i) => (
            <span class:list={['hero__sig', { 'hero__sig--name': i === 0 }]}>{part}</span>
          ))}
        </p>
      )
    }
    {
      (primary || secondary) && (
        <div class="hero__actions">
          {primary && (
            <Button href={primary.href} variant="primary">
              {primary.label}
            </Button>
          )}
          {secondary && (
            <Button href={secondary.href} variant="secondary">
              {secondary.label}
            </Button>
          )}
        </div>
      )
    }
  </div>

  <!-- Móvil: la foto entra por debajo del texto solo por su pared vacía. -->
  <figure class="hero__mobile">
    <img
      src={mobile.src}
      srcset={mobile.srcSet.attribute}
      sizes="100vw"
      width={mobileSrc.width}
      height={mobileSrc.height}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </figure>

  <!-- Tablet y desktop: arco centrado en su mitad. -->
  <div class="hero__desktop">
    <ArchPhoto
      src={imageDesktop}
      alt={alt}
      loading="eager"
      focus={focusDesktop}
      caption={caption}
      sizes="(min-width: 960px) 40vw, 100vw"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    padding-top: clamp(1.5rem, 5vh, 3rem);
  }
  .hero__text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .hero__title {
    font-size: var(--step-h1);
    max-width: 18ch;
  }
  .hero__subtitle {
    font-size: calc(var(--step-body) * 1.1);
    max-width: 32ch;
  }
  .hero__signature {
    font-size: var(--step-small);
    letter-spacing: 0.05em;
    color: var(--fg-soft);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.6ch;
    row-gap: 0.15rem;
  }
  .hero__sig--name {
    flex-basis: 100%;
    color: var(--fg);
  }
  .hero__sig:not(.hero__sig--name):not(:last-child)::after {
    content: '·';
    margin-left: 0.6ch;
    color: var(--olive);
  }
  /* Dos botones del mismo ancho, apilados y centrados en móvil. */
  .hero__actions {
    display: grid;
    gap: var(--space-2);
    width: min(100%, 20rem);
    margin-top: var(--space-1);
  }
  .hero__actions :global(.btn) {
    width: 100%;
  }

  /* Móvil (< 640 px): texto sobre el espacio negativo (36 % superior de la foto); la cara empieza al 51 %. */
  .hero__mobile {
    position: relative;
    margin: -55vw 0 0;
  }
  .hero__mobile img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1366 / 2048;
    object-fit: cover;
  }
  .hero__mobile::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--ivory) 0%,
      color-mix(in srgb, var(--ivory) 88%, transparent) 22%,
      color-mix(in srgb, var(--ivory) 45%, transparent) 36%,
      transparent 48%
    );
  }
  .hero__desktop {
    display: none;
  }

  /* Tablet (640 a 959 px): apilado y centrado, sin superposición. */
  @media (min-width: 640px) {
    .hero {
      gap: var(--space-6);
      padding-inline: var(--gutter);
      justify-items: center;
      text-align: center;
    }
    .hero__text {
      padding-inline: 0;
      justify-items: center;
    }
    .hero__title,
    .hero__subtitle {
      margin-inline: auto;
    }
    .hero__actions {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      width: auto;
      justify-content: center;
    }
    .hero__actions :global(.btn) {
      width: auto;
    }
    .hero__mobile {
      display: none;
    }
    .hero__desktop {
      display: block;
      width: min(100%, 26rem);
    }
  }

  /* Desktop: dos mitades iguales, texto centrado en vertical, arco centrado en su mitad. */
  @media (min-width: 960px) {
    .hero {
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
      padding: var(--space-6) 0 var(--space-8);
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: clamp(2rem, 6vw, 6rem);
      text-align: left;
      justify-items: stretch;
    }
    .hero__text {
      max-width: 34rem;
      margin-inline: 0;
      justify-items: start;
      text-align: left;
    }
    .hero__title {
      max-width: 15ch;
    }
    .hero__signature {
      justify-content: flex-start;
    }
    .hero__title,
    .hero__subtitle,
    .hero__signature {
      margin-inline: 0;
    }
    .hero__actions {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      width: auto;
    }
    .hero__actions :global(.btn) {
      width: auto;
    }
    .hero__desktop {
      width: min(100%, 33rem);
      justify-self: center;
    }
    .hero {
      min-height: calc(100vh - var(--nav-height));
      align-content: center;
    }
  }
</style>

---
interface Item {
  title: string;
  text: string;
}
interface Props {
  items: Item[];
  columns?: 2 | 3 | 4;
}
const { items, columns = 4 } = Astro.props;
---

<ul class:list={['offer', `offer--${columns}`]} role="list">
  {
    items.map((item, i) => (
      <li class="offer__item" data-reveal style={`--reveal-index: ${i + 1}`}>
        <h3 class="offer__title">{item.title}</h3>
        <p class="offer__text">{item.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .offer {
    display: grid;
    gap: var(--space-6) var(--space-4);
    padding: 0;
  }
  .offer__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: center;
    text-align: center;
    padding-top: var(--space-3);
    position: relative;
  }
  .offer__item::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--olive);
    margin-bottom: var(--space-1);
  }
  .offer__title {
    font-size: calc(var(--step-h3) * 0.82);
    text-wrap: balance;
  }
  .offer__text {
    color: var(--fg);
    font-size: var(--step-small);
    max-width: 28ch;
  }
  /* Cuatro pilares en retícula 2×2 desde 360 px: geometría clara y menos scroll. */
  @media (min-width: 360px) {
    .offer--4 {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-3);
    }
  }
  @media (max-width: 639px) {
    .offer--4 .offer__title {
      font-size: calc(var(--step-h3) * 0.72);
    }
    .offer--4 .offer__text {
      font-size: calc(var(--step-small) * 0.95);
    }
  }
  @media (min-width: 640px) {
    .offer--2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .offer--3 {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5) var(--space-3);
    }
  }
  @media (min-width: 960px) {
    .offer--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .offer--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
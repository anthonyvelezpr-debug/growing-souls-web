---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AppointmentForm from '../../components/AppointmentForm.astro';
import { site } from '../../data/site';
---

<Base
  title="Solicitar una cita · Growing Souls"
  description="Solicita una cita con la Dra. Melanie Acevedo Vélez. Terapia individual y de pareja, presencial o en línea."
>
  <PageHero
    eyebrow="Agenda"
    title="Solicitar una cita."
    subtitle="No tienes que contarme nada todavía. Solo necesito saber cómo encontrarte."
  />

  <section class="section section--tight">
    <div class="container agenda">
      <aside class="agenda__aside" data-reveal>
        <p class="eyebrow">Qué pasa después</p>
        <ol class="agenda__steps">
          <li>Envías el formulario.</li>
          <li>Te escribo para coordinar día, hora y modalidad.</li>
          <li>Recibes la confirmación y, si es virtual, el enlace de la sesión.</li>
        </ol>
        {
          (site.contact.email || site.contact.instagram) && (
            <div class="agenda__alt">
              <p class="eyebrow">Otras formas de contacto</p>
              <ul role="list">
                {site.contact.email && (
                  <li>
                    <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
                  </li>
                )}
                {site.contact.instagram && (
                  <li>
                    <a href={`https://www.instagram.com/${site.contact.instagram}/`} rel="noopener">
                      Instagram · @{site.contact.instagram}
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )
        }
      </aside>
      <div class="agenda__form" data-reveal style="--reveal-index: 1">
        <AppointmentForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .agenda {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }
  .agenda__steps {
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-2);
    padding-left: 1.2em;
    font-family: var(--font-serif);
    font-size: calc(var(--step-h3) * 0.8);
    line-height: 1.3;
  }
  .agenda__steps li::marker {
    color: var(--olive-deep);
    font-style: italic;
  }
  .agenda__alt {
    margin-top: var(--space-6);
  }
  .agenda__alt ul {
    margin-top: var(--space-2);
    display: grid;
    gap: 0.5rem;
    padding: 0;
    font-size: var(--step-small);
  }
  @media (min-width: 960px) {
    .agenda {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--space-10);
    }
    .agenda__aside {
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
    }
  }
</style>

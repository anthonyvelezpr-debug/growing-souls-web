---
/**
 * Foto con máscara de arco (eco de la curva de la S del isotipo) y marco de línea desfasado.
 * Es la forma "protagonista" del sistema: hero, cabeceras de página y tríptico.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  focus?: string;
  ratio?: string;
  caption?: string;
  frame?: boolean;
  /** Acercamiento del recorte (1 = sin zoom). Se ancla en el punto de enfoque. */
  zoom?: number;
  /** Media query en la que la foto está oculta por CSS: evita descargarla (p. ej. "(max-width: 639px)"). */
  hideMedia?: string;
  class?: string;
}
const {
  src,
  alt,
  sizes = '(min-width: 960px) 44vw, 100vw',
  widths = [480, 720, 960, 1200],
  loading = 'lazy',
  focus = '50% 20%',
  ratio = '4 / 5',
  caption,
  frame = true,
  zoom = 1,
  hideMedia,
  class: className = '',
} = Astro.props;

const img = await getImage({ src, widths, format: 'webp', quality: 82 });
/* Píxel transparente: cuando la media query coincide, el navegador elige esta fuente y no descarga la foto. */
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const captionLines = caption ? caption.split(' · ') : [];
---

<figure class:list={['arch', { 'arch--frame': frame }, className]} style={`--focus: ${focus}; --ratio: ${ratio}; --zoom: ${zoom}`} data-reveal>
  <div class="arch__mask">
    <picture>
      {hideMedia && <source media={hideMedia} srcset={BLANK} />}
      <img
        src={img.src}
        srcset={img.srcSet.attribute}
        sizes={sizes}
        width={src.width}
        height={src.height}
        alt={alt}
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        decoding="async"
      />
    </picture>
  </div>
  {
    caption && (
      <figcaption class="arch__caption">
        {captionLines.map((line, i) => (
          <span class:list={['arch__caption-line', { 'arch__caption-line--sub': i > 0 }]}>{line}</span>
        ))}
      </figcaption>
    )
  }
</figure>

<style>
  .arch {
    position: relative;
    margin: 0;
    display: grid;
    gap: var(--space-2);
    justify-items: center;
  }
  .arch__mask {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    border-radius: 999px 999px var(--radius) var(--radius);
    overflow: hidden;
    isolation: isolate;
  }
  .arch__mask picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .arch__mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transform-origin: var(--focus);
    transform: scale(calc(var(--zoom) * 1.04));
    transition: transform 1400ms var(--ease);
  }
  .arch.is-visible .arch__mask img {
    transform: scale(var(--zoom));
  }
  /* Marco de línea desfasado: detalle editorial que repite la geometría del arco.
     El marco vive dentro de la caja de la figura (padding), así foto + marco se centran como conjunto. */
  .arch--frame {
    padding: 0 14px 14px 0;
  }
  .arch--frame::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 14px;
    width: calc(100% - 14px);
    aspect-ratio: var(--ratio);
    border: 1px solid var(--olive);
    border-radius: 999px 999px var(--radius) var(--radius);
    opacity: 0.7;
    pointer-events: none;
  }
  .arch__caption {
    display: grid;
    gap: 0.3rem;
    justify-items: center;
    text-align: center;
    padding-top: var(--space-1);
  }
  .arch__caption-line {
    font-size: var(--step-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .arch__caption-line--sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: calc(var(--step-body) * 1.05);
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--fg-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .arch__mask img {
      transform: scale(var(--zoom));
      transition: none;
    }
  }
</style>

---
/**
 * Barra de acción fija al pie en móvil y tablet: la cita siempre a un toque del pulgar.
 * Aparece cuando el hero sale de pantalla y se oculta con el menú abierto. En desktop no existe.
 */
import { site, cta, whatsappHref } from '../data/site';
---

<div class="mbar" data-mbar aria-label="Acciones rápidas">
  <a class="mbar__cta" href={cta.href}>{cta.label}</a>
  {
    site.contact.whatsapp && (
      <a class="mbar__call" href={whatsappHref} rel="noopener" aria-label={`Escribir por WhatsApp al ${site.contact.phone}`}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .mbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    gap: 0.6rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--ivory) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
    transform: translateY(105%);
    transition: transform var(--dur-fast) var(--ease);
  }
  .mbar.is-on {
    transform: none;
  }
  :global(html.menu-open) .mbar {
    transform: translateY(105%);
  }
  .mbar__cta {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--ivory);
    font-size: var(--step-small);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .mbar__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    min-height: 3rem;
    border: 1px solid var(--navy);
    border-radius: var(--radius);
    color: var(--navy);
    text-decoration: none;
  }
  @media (min-width: 960px) {
    .mbar {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mbar {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const first = document.querySelector<HTMLElement>('main > :first-child');
  if (bar && first && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle('is-on', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      },
      { threshold: 0, rootMargin: '-40% 0px 0px 0px' },
    );
    io.observe(first);
  } else if (bar) {
    bar.classList.add('is-on');
  }
</script>

---
import Base from '../layouts/Base.astro';
import ArchPhoto from '../components/ArchPhoto.astro';
import CtaBand from '../components/CtaBand.astro';
import Verify from '../components/Verify.astro';

import fotoPerfil from '../assets/melanie/01-libros-recorte.png';
import fotoCerebro from '../assets/melanie/03-olivo-cerca.jpg';

/*
 * Conóceme, rehecha a pedido de la Dra. (5 oct 2026):
 * - Cabecera: su foto de perfil, la cita de Carl Jung que ella eligió y su párrafo sobre la psicoterapia.
 * - Una sola sección, con la foto del cerebro en la mano: "Formación académica, experiencia clínica y calidad humana",
 *   con un resumen continuo que escribirá ella (ejemplo que dio: talaveraphd.com/about-me). Hasta entonces va un
 *   texto provisional hecho solo con datos de su CV (src/data/perfil.ts).
 * - Sin capítulos y sin planes a futuro: ella se los reserva.
 * El ancla #trayectoria se mantiene porque la enlazan Misión y visión y las preguntas frecuentes.
 */
---

<Base
  title="Dra. Melanie Acevedo Vélez, PsyD · Psicóloga clínica en Puerto Rico · Growing Souls"
  description="Conoce a la Dra. Melanie Acevedo Vélez, psicóloga clínica en Puerto Rico y fundadora de Growing Souls: formación académica, experiencia clínica y calidad humana."
>
  <section class="mhero">
    <div class="container mhero__grid">
      <div class="mhero__text">
        <h1 class="eyebrow" data-reveal>Conóceme</h1>
        <figure class="mhero__quote" data-reveal style="--reveal-index: 1">
          <blockquote>
            <p>
              <Verify note="Cita de Carl Jung en la forma en que se conoce en español («Conozca…, domine…, sea…»). La Dra. la envió como «Conozco…, dominé…»">
                “Conozca todas las teorías, domine todas las técnicas, pero al tocar un alma humana, sea apenas otra alma
                humana.”
              </Verify>
            </p>
          </blockquote>
          <figcaption>Carl Jung</figcaption>
        </figure>
        <p class="mhero__lead" data-reveal style="--reveal-index: 2">
          La psicoterapia es, sin duda, un espacio que requiere preparación y herramientas clínicas. Sin embargo, también
          es un encuentro profundamente humano. Detrás de cada historia, cada síntoma y cada dificultad existe una persona
          que merece sentirse escuchada, comprendida y acompañada sin juicio.
        </p>
      </div>
      <div class="mhero__photo">
        <ArchPhoto
          src={fotoPerfil}
          alt="Melanie sostiene varios libros de psicología y sonríe"
          focus="50% 0%"
          ratio="2 / 3"
          fill="sand"
          caption="Dra. Melanie Acevedo Vélez · Psicóloga Clínica"
          loading="eager"
          sizes="(min-width: 960px) 26rem, (min-width: 640px) 22rem, 21rem"
        />
      </div>
    </div>
  </section>

  <section class="section section--sand perfil" id="trayectoria">
    <div class="container perfil__grid">
      <div class="perfil__photo">
        <ArchPhoto
          src={fotoCerebro}
          alt="Melanie, sentada en el piso, sostiene un modelo de cerebro en las manos y sonríe"
          focus="50% 40%"
          sizes="(min-width: 960px) 26rem, 22rem"
        />
      </div>
      <div class="perfil__text" data-reveal>
        <h2 class="perfil__title">Formación académica, experiencia clínica y calidad humana</h2>
        <p class="perfil__resumen">
          <Verify note="Texto provisional, hecho solo con datos de su CV. La Dra. enviará su propio resumen para esta sección">
            Soy psicóloga clínica y fundadora de Growing Souls. Completé mi bachillerato en Psicología, cum laude, en la
            Universidad de Puerto Rico, Recinto de Mayagüez, y la maestría y el doctorado en Psicología Clínica (PsyD),
            ambos con distinción, en la Universidad Albizu. Mi investigación doctoral se enfocó en la comunicación
            asertiva en el matrimonio, y realicé mi internado en una clínica comunitaria en Indiana, una experiencia que
            amplió mi mirada multicultural. Me he formado en Terapia Cognitivo-Conductual y en el Método Gottman de
            terapia de pareja. A lo largo de mi trayectoria he acompañado a personas de distintas edades, a parejas y a
            familias en procesos de ansiedad, depresión, estrés postraumático, duelo, adaptación y crianza, y en
            dificultades de pareja. También he supervisado la práctica clínica de estudiantes de maestría, he creado
            talleres abiertos a la comunidad para promover la salud mental y enseño psicología clínica y salud mental en
            HBN Academy. Esa preparación es la base de mi trabajo. Lo que la completa es la calidad humana: escuchar con
            atención, validar lo que cada persona siente y acompañarla sin juicio, con respeto por su historia y por su
            ritmo.
          </Verify>
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Conoce mi misión, mi visión y cómo trabajo."
    subtitle="Lo que guía mi práctica, lo que puedes esperar de una sesión y los enfoques en los que me he formado."
    cta={{ label: 'Misión y visión', href: '/mision-y-vision/' }}
    tone="ivory"
  />
</Base>

<style>
  /* Cabecera: texto y arco lado a lado en desktop; en móvil y tablet, primero la foto de perfil y todo centrado. */
  .mhero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 7rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .mhero__grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  .mhero__text {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }
  .mhero__quote {
    margin: 0;
    display: grid;
    gap: var(--space-2);
    justify-items: inherit;
  }
  .mhero__quote blockquote {
    margin: 0;
  }
  .mhero__quote p {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.85rem);
    line-height: 1.16;
    letter-spacing: -0.005em;
    text-wrap: balance;
    max-width: 21ch;
    color: var(--fg);
  }
  .mhero__quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step-small);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--olive-deep);
  }
  .mhero__quote figcaption::before,
  .mhero__quote figcaption::after {
    content: '';
    width: 2rem;
    border-top: 1px solid var(--olive);
  }
  .mhero__lead {
    font-size: calc(var(--step-body) * 1.06);
    line-height: 1.65;
    max-width: 44ch;
    text-wrap: pretty;
  }
  .mhero__photo {
    order: -1;
    width: min(100%, 21rem);
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .mhero__photo {
      width: min(100%, 22rem);
    }
  }
  @media (min-width: 960px) {
    .mhero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
    .mhero__text {
      justify-items: start;
      text-align: left;
    }
    .mhero__quote figcaption::after {
      display: none;
    }
    .mhero__photo {
      order: 0;
      width: min(100%, 26rem);
      justify-self: center;
    }
  }

  /* Formación académica, experiencia clínica y calidad humana: foto a la izquierda y un resumen continuo. */
  .perfil {
    scroll-margin-top: var(--nav-height);
  }
  .perfil__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .perfil__photo {
    width: min(100%, 22rem);
    margin-inline: auto;
  }
  .perfil__text {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }
  .perfil__title {
    font-size: calc(var(--step-h2) * 0.86);
    max-width: 21ch;
  }
  .perfil__resumen {
    max-width: 62ch;
    line-height: 1.7;
    text-wrap: pretty;
  }
  @media (min-width: 960px) {
    .perfil__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
    .perfil__photo {
      width: min(100%, 26rem);
    }
    .perfil__text {
      justify-items: start;
      text-align: left;
    }
  }
</style>

---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site, isPreview, nombresRuta } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
  /** Barra fija de acción en móvil (cita y llamada). Se apaga en agenda y crisis. */
  mobileBar?: boolean;
}

const {
  title,
  description,
  ogImage = site.ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  bodyClass = '',
  mobileBar = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const isHome = Astro.url.pathname === '/';

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: site.name,
    inLanguage: 'es-PR',
    publisher: { '@id': `${site.url}/#org` },
  },
  {
    '@type': ['MedicalBusiness', 'LocalBusiness'],
    '@id': `${site.url}/#org`,
    name: site.name,
    alternateName: 'Growing Souls PR',
    legalName: 'Growing Souls',
    url: `${site.url}/`,
    logo: `${site.url}/images/brand/logo-circular-navy.png`,
    image: ogImageUrl,
    description: site.description,
    slogan: site.tagline,
    telephone: `+1-${site.contact.phone}`,
    email: site.contact.email,
    sameAs: [`https://www.instagram.com/${site.contact.instagram}/`],
    inLanguage: 'es-PR',
    medicalSpecialty: 'Psychiatric',
    knowsAbout: [
      'Psicología clínica',
      'Psicoterapia individual para adultos',
      'Terapia de pareja',
      'Terapia cognitivo-conductual',
      'Método Gottman',
      'Ansiedad',
      'Depresión',
      'Manejo del estrés',
      'Bienestar emocional',
      'Psicoeducación',
      'Talleres y conferencias de salud mental',
    ],
    founder: { '@id': `${site.url}/#person` },
    employee: { '@id': `${site.url}/#person` },
    areaServed: { '@type': 'AdministrativeArea', name: site.location.areaServed },
    address: {
      '@type': 'PostalAddress',
      ...(site.location.locality ? { addressLocality: site.location.locality } : {}),
      addressRegion: site.location.region,
      addressCountry: 'PR',
    },
    availableService: [
      { '@type': 'Service', '@id': `${site.url}/terapia-individual/#service`, name: 'Psicoterapia individual para adultos', url: `${site.url}/terapia-individual/` },
      { '@type': 'Service', '@id': `${site.url}/parejas/#service`, name: 'Terapia de pareja', url: `${site.url}/parejas/` },
      { '@type': 'Service', '@id': `${site.url}/talleres-y-conferencias/#service`, name: 'Talleres y conferencias de psicoeducación', url: `${site.url}/talleres-y-conferencias/` },
    ],
  },
  {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: 'Melanie Acevedo Vélez',
    alternateName: ['Dra. Melanie Acevedo Vélez', 'Dra. Melanie Acevedo', 'Melanie Acevedo Vélez, PsyD'],
    honorificPrefix: 'Dra.',
    honorificSuffix: site.person.degree,
    jobTitle: site.person.jobTitle,
    description:
      'Psicóloga clínica en Puerto Rico (PsyD, Universidad Albizu) y fundadora de Growing Souls. Psicoterapia individual para adultos, terapia de pareja y talleres de psicoeducación.',
    hasOccupation: { '@type': 'Occupation', name: 'Psicóloga clínica', occupationLocation: { '@type': 'AdministrativeArea', name: 'Puerto Rico' } },
    worksFor: { '@id': `${site.url}/#org` },
    url: `${site.url}/melanie/`,
    image: ogImageUrl,
    /* Formación según su CV (2026). */
    alumniOf: [
      { '@type': 'CollegeOrUniversity', name: 'Universidad Albizu' },
      { '@type': 'CollegeOrUniversity', name: 'Universidad de Puerto Rico, Recinto de Mayagüez' },
    ],
    hasCredential: [
      {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'degree',
        name: 'Doctorado en Psicología Clínica (PsyD)',
        recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Universidad Albizu' },
      },
    ],
    knowsAbout: ['Psicología clínica', 'Terapia de pareja', 'Terapia cognitivo-conductual', 'Método Gottman', 'Comunicación asertiva'],
    knowsLanguage: 'es',
  },
  ...jsonLd,
];

/* Página actual: nombre, descripción y migas con nombres legibles (las migas usan el título de la página en el último tramo). */
const pageTitle = title.split(' · ')[0];
graph.push({
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: pageTitle,
  description,
  inLanguage: 'es-PR',
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#org` },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
  ...(isHome ? {} : { breadcrumb: { '@id': `${canonical}#breadcrumb` } }),
});
if (!isHome) {
  const segments = Astro.url.pathname.split('/').filter(Boolean);
  const items = [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` }];
  let path = '';
  segments.forEach((seg, i) => {
    path += `/${seg}`;
    const last = i === segments.length - 1;
    items.push({
      '@type': 'ListItem',
      position: i + 2,
      name: last ? pageTitle : (nombresRuta[seg] ?? seg.replace(/-/g, ' ')),
      item: `${site.url}${path}/`,
    });
  });
  graph.push({ '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: items });
}

const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="es-PR" class="no-js" data-show-verify={isPreview ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      )
    }
    <meta name="author" content={site.person.name} />
    <meta name="geo.region" content="PR" />
    <meta name="geo.placename" content="Puerto Rico" />
    {site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    <meta name="theme-color" content="#fbfaea" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.person.name}, psicóloga clínica en Puerto Rico`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="preload"
      href="/fonts/CormorantGaramond-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/ClearSans-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline set:html={`document.documentElement.classList.remove('no-js');${isPreview ? "document.documentElement.setAttribute('data-show-verify','');" : ''}`} />
    <script type="application/ld+json" set:html={structuredData} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Nav />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {mobileBar && <MobileBar />}

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      /* Listas corridas con punto medio: el separador no debe quedar al inicio de una línea.
         Marcamos el primer elemento de cada línea para ocultar su separador. */
      const dotlists = document.querySelectorAll<HTMLElement>('[data-dotlist]');
      const markLineStarts = () => {
        dotlists.forEach((list) => {
          let prevTop: number | null = null;
          for (const li of list.querySelectorAll<HTMLElement>(':scope > li, :scope > span')) {
            const top = li.offsetTop;
            li.classList.toggle('is-line-start', prevTop === null || top !== prevTop);
            prevTop = top;
          }
        });
      };
      if (dotlists.length) {
        markLineStarts();
        document.fonts?.ready.then(markLineStarts);
        let raf = 0;
        window.addEventListener('resize', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(markLineStarts);
        });
      }
    </script>
  </body>
</html>

---
/**
 * Barra de acción fija al pie en móvil y tablet: la cita siempre a un toque del pulgar.
 * Aparece cuando el hero sale de pantalla y se oculta con el menú abierto. En desktop no existe.
 */
import { site, cta } from '../data/site';
const phoneHref = site.contact.phone ? `tel:${site.contact.phone.replace(/\D/g, '')}` : '';
---

<div class="mbar" data-mbar aria-label="Acciones rápidas">
  <a class="mbar__cta" href={cta.href}>{cta.label}</a>
  {
    phoneHref && (
      <a class="mbar__call" href={phoneHref} aria-label={`Llamar al ${site.contact.phone}`}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5.5 3h3l1.6 4-2 1.3a12 12 0 0 0 5.6 5.6l1.3-2 4 1.6v3a2 2 0 0 1-2.1 2A15.5 15.5 0 0 1 3.5 5.1 2 2 0 0 1 5.5 3z" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .mbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    gap: 0.6rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--ivory) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
    transform: translateY(105%);
    transition: transform var(--dur-fast) var(--ease);
  }
  .mbar.is-on {
    transform: none;
  }
  :global(html.menu-open) .mbar {
    transform: translateY(105%);
  }
  .mbar__cta {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--ivory);
    font-size: var(--step-small);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .mbar__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    min-height: 3rem;
    border: 1px solid var(--navy);
    border-radius: var(--radius);
    color: var(--navy);
    text-decoration: none;
  }
  @media (min-width: 960px) {
    .mbar {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mbar {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const first = document.querySelector<HTMLElement>('main > :first-child');
  if (bar && first && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle('is-on', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      },
      { threshold: 0, rootMargin: '-40% 0px 0px 0px' },
    );
    io.observe(first);
  } else if (bar) {
    bar.classList.add('is-on');
  }
</script>

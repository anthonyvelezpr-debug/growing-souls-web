---
import Base from '../../layouts/Base.astro';
import Statement from '../../components/Statement.astro';
import Button from '../../components/Button.astro';
---

<Base mobileBar={false} title="Gracias · Growing Souls" description="Tu solicitud de cita fue recibida." noindex={true}>
  <Statement as="h1" title="Gracias por dar este paso." subtitle="Te escribo pronto para coordinar día, hora y modalidad.">
    <p class="small muted">
      Si en el camino sientes que necesitas ayuda ahora, <a href="/crisis/">aquí tienes recursos</a>.
    </p>
    <div>
      <Button href="/" variant="secondary">Volver al inicio</Button>
    </div>
  </Statement>
</Base>

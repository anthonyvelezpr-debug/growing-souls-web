---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Chapter from '../components/Chapter.astro';
import Quote from '../components/Quote.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import Verify from '../components/Verify.astro';
import { isPreview } from '../data/site';
import { formacion, formacionDetalle, formacionClinica, experiencia, experienciaClinica } from '../data/perfil';

import fotoHero from '../assets/melanie/01-libros-recorte.png';
import fotoOlivo from '../assets/melanie/03-olivo-cerca.jpg';
import fotoRetrato from '../assets/melanie/06-banquillo-recorte.png';

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const allChapters = [
  { id: 'antes', title: 'Antes de la Dra. Acevedo', preview: true },
  { id: 'acompanar', title: 'Aprender a acompañar', preview: false },
  { id: 'puerto-rico', title: 'Cuando Puerto Rico también necesitaba ser escuchado', preview: false },
  { id: 'escuchando', title: 'Lo que aprendí escuchando', preview: true },
  { id: 'psicologia', title: 'Mi manera de entender la psicología', preview: false },
  { id: 'growing-souls', title: 'Growing Souls', preview: true },
  { id: 'construir', title: 'Lo que todavía quiero construir', preview: false },
];
/* Los capítulos pendientes de entrevista solo existen en vista previa; la numeración pública es siempre correlativa. */
const chapters = allChapters.filter((c) => isPreview || !c.preview).map((c, i) => ({ ...c, numeral: roman[i] }));
const num = Object.fromEntries(chapters.map((c) => [c.id, c.numeral])) as Record<string, string>;
---

<Base
  title="Conóceme · Dra. Melanie Acevedo Vélez, PsyD · Growing Souls"
  description="Psicóloga clínica (PsyD, Universidad Albizu) y fundadora de Growing Souls. Mi historia, mi formación y mi manera de acompañar."
>
  <PageHero
    eyebrow="Conóceme"
    title="Antes de ser psicóloga, soy persona."
    subtitle="Mi historia, mi formación y la manera en que entiendo la psicología."
    image={fotoHero}
    alt="Melanie sostiene varios libros de psicología y sonríe"
    focus="50% 0%"
    ratio="2 / 3"
    fill="sand"
    caption="Dra. Melanie Acevedo Vélez · Psicóloga Clínica"
  />

  <section class="story">
    <div class="container story__grid">
      <aside class="story__index" aria-label="Capítulos">
        <p class="eyebrow">Capítulos</p>
        <ol role="list">
          {
            chapters.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="story__num">{c.numeral}</span> {c.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href="#trayectoria">
              <span class="story__num" aria-hidden="true">·</span> Formación y trayectoria
            </a>
          </li>
        </ol>
      </aside>

      <div class="story__chapters">
        <Chapter id="antes" numeral={num['antes']} title="Antes de la Dra. Acevedo" pending="Infancia, familia, por qué psicología y el momento de decir: esto es lo mío. Se escribe con la entrevista." />

        <Chapter id="acompanar" numeral={num['acompanar']} title="Aprender a acompañar" image={fotoRetrato} focus="50% 50%" fill="sand" alt="Melanie sentada en un banquillo, sonriendo hacia la cámara">
          <p>
            <Verify note="Aprobación Melanie">
              La universidad me dio teoría, estructura y conocimiento. Hay algo que ningún libro sustituye: la
              calidad humana de quien te escucha.
            </Verify>
          </p>
          <p>
            <Verify note="Aprobación Melanie · datos confirmados con su CV y su biografía de HBN Academy">
              Estudié Psicología en la Universidad de Puerto Rico, Recinto de Mayagüez, y completé la maestría y el
              doctorado en Psicología Clínica en la Universidad Albizu. Mi investigación doctoral se enfocó en la
              comunicación asertiva en el matrimonio, y realicé mi internado en una clínica comunitaria en Indiana, una
              experiencia que amplió mi mirada multicultural.
            </Verify>
          </p>
        </Chapter>

        <Chapter id="puerto-rico" numeral={num['puerto-rico']} title="Cuando Puerto Rico también necesitaba ser escuchado">
          <p>
            <Verify note="Aprobación Melanie · organizaciones, fechas y funciones por verificar">
              No viví esas crisis solo desde el rol profesional. Las viví como puertorriqueña, mientras aprendía a
              acompañar a otros.
            </Verify>
          </p>
          <p>
            <Verify note="Aprobación Melanie">
              Cuando Puerto Rico atravesaba momentos de incertidumbre, yo también estaba creciendo como persona y como
              profesional. Aprendí que escuchar, a veces, es lo primero que una comunidad necesita.
            </Verify>
          </p>
        </Chapter>

        {
          isPreview && (
            <Chapter id="escuchando" numeral={num['escuchando']} title="Lo que aprendí escuchando">
              <p class="muted small">Reflexiones propuestas. Ninguna se publica sin la aprobación de Melanie.</p>
              <ul class="story__lessons" role="list">
                {[
                  'He aprendido que muchas personas que parecen fuertes simplemente llevan demasiado tiempo sobreviviendo.',
                  'He aprendido que poner límites también puede ser una forma de amar.',
                  'He aprendido que sentir culpa no siempre significa que hicimos algo malo.',
                  'He aprendido que perdonarnos puede ser más difícil que perdonar a otros.',
                  'He aprendido que cambiar nuestra historia comienza muchas veces cambiando la manera en que nos la contamos.',
                  'He aprendido que pedir ayuda no es rendirse; es decidir dejar de cargar con todo en silencio.',
                  'He aprendido que el silencio en una sesión también dice algo, y que hay que respetarlo.',
                ].map((line) => (
                  <li>
                    <Verify note="Aprobación Melanie (frase atribuida)" hide>
                      {line}
                    </Verify>
                  </li>
                ))}
              </ul>
            </Chapter>
          )
        }

        <Chapter id="psicologia" numeral={num['psicologia']} title="Mi manera de entender la psicología" image={fotoOlivo} focus="50% 40%" alt="Melanie sentada junto a un olivo, con las manos sobre un modelo de cerebro, sonriendo">
          <Quote align="left">
            <Verify note="Aprobación Melanie">
              No estoy aquí para decirte quién debes ser. Estoy aquí para acompañarte mientras descubres quién eres,
              qué necesitas y hacia dónde quieres caminar.
            </Verify>
          </Quote>
          <p>
            <Verify note="Aprobación Melanie">
              Creo en una terapia de colaboración, no de poder. Tu vida sigue siendo tuya; yo acompaño el proceso.
              Creo en la evidencia, porque mereces herramientas que funcionan, y creo en la humanidad, porque ninguna
              herramienta sirve sin alguien que te escuche con respeto.
            </Verify>
          </p>
        </Chapter>

        <Chapter id="growing-souls" numeral={num['growing-souls']} title="Growing Souls" pending="Por qué ese nombre, quién lo escogió, qué significa y cuándo nació. Se escribe con la entrevista." />

        <Chapter id="construir" numeral={num['construir']} title="Lo que todavía quiero construir">
          <p>
            <Verify note="Aprobación Melanie">
              Growing Souls no tiene que ser solo yo. Quiero que crezca con profesionales que compartan esta manera de
              entender la psicología, y que en Puerto Rico pedir ayuda se entienda como lo que es: un acto de cuidado,
              de conciencia y de crecimiento.
            </Verify>
          </p>
          <p class="muted serif-italic story__note">Esta historia se sigue escribiendo.</p>
        </Chapter>
      </div>
    </div>
  </section>

  <section class="section section--sand trayectoria" id="trayectoria">
    <div class="container">
      <SectionHeading eyebrow="Formación y trayectoria" title="Mi preparación profesional.">
        <p class="lead">Psicóloga clínica, fundadora de Growing Souls.</p>
      </SectionHeading>
      <Verify as="div" note="Datos del CV 2026 y de la biografía de HBN Academy · Melanie confirma qué experiencia nombrar públicamente">
        <div class="tray">
          <div class="tray__col" data-reveal>
            <h3 class="tray__h">Formación académica</h3>
            <ul class="tray__list" role="list">
              {
                formacion.map((g) => (
                  <li>
                    <p class="tray__titulo">{g.titulo}</p>
                    <p class="tray__meta small">
                      {g.institucion} · {g.anio}
                      {g.honor && <span> · {g.honor}</span>}
                    </p>
                  </li>
                ))
              }
            </ul>
            <ul class="tray__notas small" role="list">
              {formacionDetalle.map((t) => <li>{t}</li>)}
            </ul>
            <h3 class="tray__h tray__h--sep">Formación clínica</h3>
            <ul class="tray__list" role="list">
              {
                formacionClinica.map((f) => (
                  <li>
                    <p class="tray__titulo">{f}</p>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="tray__col" data-reveal style="--reveal-index: 1">
            <h3 class="tray__h">Experiencia profesional</h3>
            <ul class="tray__list" role="list">
              {
                experiencia.map((e) => (
                  <li>
                    <p class="tray__titulo">{e.cargo}</p>
                    <p class="tray__meta small">
                      {e.lugar} · {e.periodo}
                    </p>
                    <p class="tray__texto small">{e.texto}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="tray__areas" data-reveal>
          <p class="eyebrow">Experiencia clínica con</p>
          <ul class="tray__chips" role="list" data-dotlist>
            {experienciaClinica.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </Verify>
    </div>
  </section>

  <CtaBand
    title="Conoce mi misión, mi visión y cómo trabajo."
    subtitle="Lo que guía mi práctica, lo que puedes esperar de una sesión y los enfoques en los que me he formado."
    cta={{ label: 'Misión y visión', href: '/mision-y-vision/' }}
    tone="ivory"
  />
</Base>

<style>
  .story {
    padding-block: var(--space-6) 0;
  }
  .story__grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  .story__index ol {
    margin-top: var(--space-2);
    display: grid;
    gap: 0.6rem;
    padding: 0;
  }
  .story__index a {
    display: flex;
    gap: 0.6rem;
    font-size: var(--step-small);
    text-decoration: none;
    color: var(--fg);
  }
  .story__index a:hover {
    text-decoration: underline;
  }
  .story__num {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--olive-deep);
    min-width: 1.6rem;
  }
  .story__lessons {
    display: grid;
    gap: var(--space-2);
    padding: 0;
  }
  .story__lessons li {
    font-family: var(--font-serif);
    font-size: calc(var(--step-h3) * 0.85);
    line-height: 1.3;
    padding-left: 1rem;
    border-left: 1px solid var(--olive);
  }
  .story__note {
    margin-top: var(--space-4);
  }
  /* Formación y trayectoria: dos columnas en desktop (formación | experiencia); una en móvil, centrada. */
  .trayectoria {
    scroll-margin-top: var(--nav-height);
  }
  .tray {
    display: grid;
    gap: var(--space-6);
  }
  .tray__h {
    font-size: calc(var(--step-h3) * 0.8);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--olive);
  }
  .tray__h--sep {
    margin-top: var(--space-5);
  }
  .tray__list {
    display: grid;
    gap: 0;
    padding: 0;
  }
  .tray__list li {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  .tray__titulo {
    font-family: var(--font-serif);
    font-variant-numeric: lining-nums;
    font-size: calc(var(--step-body) * 1.12);
    line-height: 1.3;
    color: var(--navy);
  }
  .tray__meta {
    color: var(--olive-deep);
  }
  .tray__texto {
    color: var(--fg-soft);
    max-width: 52ch;
  }
  .tray__notas {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-2);
    padding: 0;
    color: var(--fg-soft);
  }
  .tray__areas {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    text-align: center;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  /* Lista corrida con punto medio (misma pieza que en Terapia individual). */
  .tray__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 0.35rem;
    padding: 0;
    max-width: 44rem;
    font-family: var(--font-serif);
    font-size: calc(var(--step-body) * 1.1);
    line-height: 1.35;
  }
  .tray__chips li {
    position: relative;
    white-space: nowrap;
    padding-inline: 0.6em;
  }
  .tray__chips li:not(:first-child)::before {
    content: '·';
    position: absolute;
    left: 0;
    top: 0;
    transform: translateX(-50%);
    color: var(--olive);
  }
  .tray__chips li.is-line-start::before {
    display: none;
  }
  @media (max-width: 959px) {
    .tray__col {
      text-align: center;
    }
    .tray__texto {
      margin-inline: auto;
    }
  }
  @media (min-width: 960px) {
    .tray {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-10);
    }
  }
  @media (max-width: 959px) {
    .story__index {
      text-align: center;
    }
    .story__index a {
      display: inline;
    }
    .story__index li {
      max-width: 30ch;
      margin-inline: auto;
    }
    .story__num {
      min-width: 0;
      margin-right: 0.5ch;
    }
    .story__lessons li {
      padding-left: 0;
      border-left: 0;
      text-align: center;
    }
  }
  @media (min-width: 960px) {
    .story__grid {
      grid-template-columns: 16rem 1fr;
      gap: var(--space-10);
    }
    .story__index {
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import { site, whatsappHref, isPreview } from '../data/site';
const year = new Date().getFullYear();
const hayJournal = (await getCollection('journal', ({ data }) => isPreview || !data.draft)).length > 0;
---

<footer class="footer">
  <div class="footer__crisis">
    <div class="container footer__crisis-inner">
      <p class="small">
        Esta web no es un servicio de emergencias. Si estás en crisis, <a href="/crisis/">aquí tienes recursos</a>.
      </p>
    </div>
  </div>

  <div class="container footer__inner">
    <div class="footer__brand">
      <img
        src="/images/brand/logo-circular-navy-360.png"
        alt="Growing Souls, Dra. Melanie Acevedo"
        width="120"
        height="120"
        loading="lazy"
        decoding="async"
      />
      <p class="footer__person">
        <strong>{site.person.name}</strong>
        <span>{site.person.jobTitle}</span>
        <span>{site.location.locality ? `${site.location.locality}, ${site.location.country}` : site.location.country}</span>
      </p>
    </div>

    <div class="footer__cols">
      <nav class="footer__col" aria-label="Páginas">
        <p class="eyebrow">Explorar</p>
        <ul role="list">
          <li><a href="/melanie/">Conoce a Melanie</a></li>
          <li><a href="/como-trabajo/">Cómo trabajo</a></li>
          <li><a href="/terapia-individual/">Terapia individual</a></li>
          <li><a href="/parejas/">Parejas</a></li>
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Servicios y recursos">
        <p class="eyebrow">Servicios</p>
        <ul role="list">
          <li><a href="/talleres-y-conferencias/">Talleres y conferencias</a></li>
          <li><a href="/conocete-mejor/">Conócete mejor</a></li>
          {hayJournal && <li><a href="/journal/">Growing Journal</a></li>}
          <li><a href="/agenda/">Solicitar una cita</a></li>
        </ul>
      </nav>

      <div class="footer__col">
        <p class="eyebrow">Contacto</p>
        <ul role="list">
          {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
          {site.contact.phone && <li><a href={whatsappHref} rel="noopener">WhatsApp · {site.contact.phone}</a></li>}
          {
            site.contact.instagram && (
              <li>
                <a href={`https://www.instagram.com/${site.contact.instagram}/`} rel="noopener">
                  @{site.contact.instagram}
                </a>
              </li>
            )
          }
          <li><a href="/privacidad/">Privacidad</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer__bottom small muted">
    <p>© {year} Growing Souls · {site.person.name} · Psicoterapia en Puerto Rico</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--sand);
    text-align: center;
  }
  .footer__crisis {
    background: var(--ivory);
    border-bottom: 1px solid var(--line);
  }
  .footer__crisis-inner {
    padding-block: var(--space-2);
    color: var(--fg-soft);
  }
  .footer__inner {
    display: grid;
    gap: var(--space-8);
    justify-items: center;
    padding-block: var(--space-8) var(--space-6);
  }
  .footer__brand {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  .footer__brand img {
    width: 120px;
  }
  .footer__person {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step-small);
    line-height: 1.5;
  }
  .footer__cols {
    display: grid;
    gap: var(--space-6) var(--space-4);
    width: 100%;
  }
  /* Móvil: Explorar y Servicios lado a lado; Contacto debajo a todo el ancho. */
  @media (max-width: 639px) {
    .footer__cols {
      grid-template-columns: 1fr 1fr;
    }
    .footer__col:last-child {
      grid-column: 1 / -1;
    }
  }
  .footer__col ul {
    margin-top: var(--space-2);
    display: grid;
    gap: 0.55rem;
    padding: 0;
  }
  .footer__col a {
    text-decoration: none;
    font-size: var(--step-small);
    background: linear-gradient(var(--olive), var(--olive)) no-repeat center bottom / 0 1px;
    transition: background-size var(--dur-fast) var(--ease);
    padding-bottom: 1px;
  }
  .footer__col a:hover {
    background-size: 100% 1px;
    opacity: 1;
  }
  .footer__bottom {
    padding-block: var(--space-3) var(--space-6);
    border-top: 1px solid var(--line);
  }
  /* Hueco para la barra fija de acción (visible hasta que aparece la barra de navegación de escritorio). */
  @media (max-width: 1199px) {
    .footer__bottom {
      padding-bottom: calc(var(--space-6) + 4rem + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (min-width: 640px) {
    .footer__cols {
      grid-template-columns: repeat(3, 1fr);
      max-width: 52rem;
    }
  }
</style>

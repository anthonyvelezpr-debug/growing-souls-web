---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Triptych from '../components/Triptych.astro';
import fotoMirada from '../assets/melanie/05-mirada-abajo-cerca.jpg';
import CtaBand from '../components/CtaBand.astro';
import Verify from '../components/Verify.astro';
import Faq from '../components/Faq.astro';
import { faqParejas, faqSchema } from '../data/faq';
import { site } from '../data/site';

const servicio = {
  '@type': 'Service',
  '@id': `${site.url}/parejas/#service`,
  name: 'Terapia de pareja',
  serviceType: 'Terapia de pareja',
  description:
    'Terapia de pareja en Puerto Rico con la Dra. Melanie Acevedo Vélez, formada en el Método Gottman (Nivel 1): comunicación, conflictos que se repiten, confianza e infidelidad, conexión emocional. Presencial o en línea.',
  url: `${site.url}/parejas/`,
  provider: { '@id': `${site.url}/#org` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Puerto Rico' },
  audience: { '@type': 'Audience', audienceType: 'Parejas' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `${site.url}/agenda/`,
    availableLanguage: 'es',
  },
};

const situaciones = [
  'Conversaciones que siempre terminan igual.',
  'Conflictos que se repiten con distinto nombre.',
  'Sentir que ya no se encuentran.',
  'Necesidades que nunca se dijeron en voz alta.',
  'Límites que no se establecieron a tiempo.',
  'Patrones que vienen de antes de conocerse.',
  'Resentimientos que se acumulan en silencio.',
  'Un perdón que no termina de llegar.',
  'Una infidelidad y la dificultad de reconstruir la confianza.',
  'Intimidad emocional que se fue enfriando.',
  'Miedo a mostrarse vulnerable frente a la otra persona.',
];
---

<Base
  title="Terapia de pareja en Puerto Rico · Método Gottman · Growing Souls"
  description="Terapia de pareja en Puerto Rico, presencial o en línea, con la Dra. Melanie Acevedo Vélez (Método Gottman). Comunicación, conflictos, confianza e infidelidad."
  jsonLd={[servicio, faqSchema(faqParejas.items, `${site.url}/parejas/`)]}
>
  <PageHero
    eyebrow="Terapia de pareja"
    title="Amarnos no significa automáticamente saber relacionarnos."
    subtitle="Querer a alguien y saber comunicarse, discutir y reconectar son cosas distintas. Las segundas se aprenden."
    tone="sand"
  />

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Lo que trae a una pareja" title="Situaciones frecuentes que llevan a una pareja a buscar ayuda." />
      <ul class="situaciones" role="list">
        {
          situaciones.map((s, i) => (
            <li data-reveal style={`--reveal-index: ${i % 4}`}>
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container--narrow prose" data-reveal>
      <h2>Cómo trabajo con parejas</h2>
      <p>
        No vengo a decidir quién tiene la razón. Vengo a ayudarles a ver el patrón en el que están atrapados los dos,
        y a encontrar otra manera de hablarse.
        <Verify note="Formación según su CV: Método Gottman, Nivel 1">
          Me he formado en el Método Gottman de terapia de pareja (Nivel 1), que se apoya en décadas de investigación
          sobre lo que ayuda a que una relación funcione.
        </Verify>
      </p>
      <p>
        <Verify note="Aprobación Melanie · tema de la disertación confirmado en su biografía de HBN Academy">
          Mi interés por las relaciones viene de lejos: mi investigación doctoral se enfocó en la comunicación asertiva
          en el matrimonio, y desde entonces sigo estudiando cómo dos personas pueden aprender a expresarse lo que es
          importante para cada una.
        </Verify>
      </p>
      <p>
        <Verify note="Aprobación Melanie">
          Me apasionan las relaciones porque en ellas se juega casi todo lo que importa: cómo pedimos, cómo cuidamos,
          cómo nos perdonamos y cómo volvemos a acercarnos después de habernos alejado.
        </Verify>
      </p>

      <h2>La primera sesión de pareja</h2>
      <p>
        Vienen los dos. Hablamos de cómo llegaron hasta aquí, qué quiere cada uno y qué esperan del proceso. No hace
        falta estar de acuerdo para empezar.
        <Verify note="Verificar: formato y si hay sesiones individuales dentro del proceso" hide>
          Aquí se describe después el formato exacto del proceso.
        </Verify>
      </p>

      <h2>Cuándo no es terapia de pareja</h2>
      <p>
        <Verify note="Revisión clínica">
          Si hay violencia en la relación, la terapia de pareja no es el primer paso; lo primero es tu seguridad.
          <a href="/crisis/">Aquí tienes recursos</a>.
        </Verify>
      </p>
    </div>
  </section>

  <Triptych
    image={fotoMirada}
    alt="Melanie sonríe mirando hacia abajo, con las manos sobre un modelo de cerebro"
    focus="50% 30%"
    quote="Querer a alguien es un punto de partida. Aprender a relacionarnos es el camino."
    quoteCite="Terapia de pareja"
    eyebrow="Cómo trabajo con parejas"
    title="No vengo a decidir quién tiene la razón."
    cta={{ label: 'Hablemos de relaciones', href: '/agenda/' }}
    tone="ivory"
  >
    <p>
      Vengo a ayudarles a ver el patrón en el que están atrapados los dos, y a encontrar otra manera de hablarse. No
      hace falta estar de acuerdo para empezar.
    </p>
  </Triptych>

  <Faq
    title="Preguntas frecuentes sobre la terapia de pareja."
    items={faqParejas.items}
    tone="sand"
    more={{ label: 'Ver todas las preguntas frecuentes', href: '/preguntas-frecuentes/' }}
  />

  <CtaBand
    title="Si algo de esto les suena, podemos explorarlo."
    subtitle="Sin decidir quién tiene la razón. Sin presión."
    cta={{ label: 'Hablemos de relaciones', href: '/agenda/' }}
    tone="ivory"
  />
</Base>

<style>
  .situaciones {
    display: grid;
    gap: var(--space-2);
    padding: 0;
  }
  .situaciones li {
    font-family: var(--font-serif);
    font-size: calc(var(--step-h3) * 0.85);
    line-height: 1.3;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  /* Móvil: centrado como el resto de la página. */
  @media (max-width: 639px) {
    .situaciones {
      gap: 0;
    }
    .situaciones li {
      text-align: center;
      padding: var(--space-2) var(--space-2);
      text-wrap: balance;
    }
  }
  @media (min-width: 640px) {
    .situaciones {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 var(--space-6);
    }
  }
</style>

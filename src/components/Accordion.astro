---
interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="accordion" data-reveal>
  {
    items.map((item) => (
      <details class="accordion__item">
        <summary class="accordion__summary">
          <span>{item.q}</span>
          <span class="accordion__icon" aria-hidden="true" />
        </summary>
        <div class="accordion__body">
          <p set:html={item.a} />
        </div>
      </details>
    ))
  }
</div>

<style>
  .accordion {
    border-top: 1px solid var(--line);
  }
  /* La apertura y el cierre los anima src/scripts/motion.ts (altura y fundido); aquí, el estado visual. */
  .accordion__item {
    border-bottom: 1px solid var(--line);
    transition: border-color var(--dur-base) var(--ease);
  }
  .accordion__item:hover,
  .accordion__item.is-open {
    border-bottom-color: color-mix(in srgb, var(--olive) 45%, var(--line));
  }
  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: calc(var(--step-h3) * 0.85);
    line-height: 1.25;
    transition: color var(--dur-fast) var(--ease);
  }
  .accordion__summary:hover {
    color: var(--olive-deep);
  }
  .accordion__summary::-webkit-details-marker {
    display: none;
  }
  .accordion__icon {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    position: relative;
  }
  .accordion__icon::before,
  .accordion__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: var(--olive-deep);
    transition: transform var(--dur-slow) var(--ease-in-out);
  }
  .accordion__icon::after {
    transform: rotate(90deg);
  }
  /* El signo + se convierte en − al mismo tiempo que el contenido se abre (y vuelve mientras se cierra). */
  .accordion__item.is-open .accordion__icon::after,
  :global(html.no-js) details[open] .accordion__icon::after {
    transform: rotate(0deg);
  }
  .accordion__body {
    padding: 0 0 1.4rem;
    max-width: var(--measure);
  }
</style>

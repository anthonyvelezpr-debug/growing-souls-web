---
interface Service {
  title: string;
  text: string;
  href: string;
  label: string;
}
interface Props {
  services: Service[];
}
const { services } = Astro.props;
---

<ul class="services" role="list">
  {
    services.map((s, i) => (
      <li class="services__card" data-reveal style={`--reveal-index: ${i + 1}`}>
        <h3 class="services__title">
          <a href={s.href}>{s.title}</a>
        </h3>
        <p class="services__text serif-italic">{s.text}</p>
        <a class="services__link" href={s.href}>
          {s.label} <span aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .services {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }
  .services__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    text-align: center;
    padding: var(--space-6) var(--space-3);
    border-top: 1px solid var(--olive);
    transition: background-color var(--dur-fast) var(--ease);
  }
  .services__card:hover {
    background: color-mix(in srgb, var(--sand) 60%, transparent);
  }
  .services__title {
    font-size: var(--step-h3);
  }
  .services__title a {
    text-decoration: none;
  }
  .services__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .services__text {
    font-size: calc(var(--step-body) * 1.12);
    max-width: 26ch;
  }
  .services__link {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: var(--step-small);
    color: var(--olive-deep);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: letter-spacing var(--dur-fast) var(--ease);
  }
  .services__link span {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease);
  }
  .services__card:hover .services__link span {
    transform: translateX(4px);
  }
  @media (min-width: 960px) {
    .services {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
</style>
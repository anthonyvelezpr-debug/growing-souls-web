---
interface Area {
  title: string;
  intro?: string;
  topics: string[];
  href?: string;
}
interface Props {
  areas: Area[];
}
const { areas } = Astro.props;
---

<ul class="areas" role="list">
  {
    areas.map((area, i) => (
      <li class="areas__card" data-reveal style={`--reveal-index: ${i + 1}`}>
        <h3 class="areas__title">{area.title}</h3>
        <span class="areas__rule" aria-hidden="true" />
        {area.intro && <p class="areas__intro">{area.intro}</p>}
        <ul class="areas__topics" role="list">
          {area.topics.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        {area.href && (
          <a class="areas__link" href={area.href}>
            Explorar <span aria-hidden="true">→</span>
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .areas {
    display: grid;
    gap: var(--space-3);
    padding: 0;
  }
  .areas__card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: center;
    text-align: center;
    padding: var(--space-6) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ivory);
  }
  .areas__title {
    font-size: var(--step-h3);
    font-style: italic;
  }
  .areas__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--olive);
  }
  .areas__intro {
    font-size: var(--step-small);
  }
  /* Lista en dos columnas centradas, sin adornos: la retícula hace el trabajo. */
  .areas__topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 0.55rem;
    padding: 0;
    width: 100%;
    max-width: 22rem;
    font-family: var(--font-serif);
    font-size: calc(var(--step-body) * 1.1);
    line-height: 1.3;
    color: var(--fg);
  }
  .areas__topics li {
    flex: 0 0 50%;
    text-align: center;
    padding-inline: 0.5rem;
  }
  .areas__link {
    margin-top: var(--space-1);
    font-size: var(--step-small);
    color: var(--olive-deep);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  @media (min-width: 960px) {
    .areas {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
    .areas__card {
      padding: var(--space-8) var(--space-4);
    }
  }
</style>
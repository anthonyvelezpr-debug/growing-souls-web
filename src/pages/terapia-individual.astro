---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Verify from '../components/Verify.astro';

import ArchPhoto from '../components/ArchPhoto.astro';
import fotoLibros from '../assets/melanie/01-libros-recorte.png';

const universos = [
  {
    id: 'tu-contigo',
    title: 'Tú contigo',
    text: 'La relación más larga de tu vida es contigo. Aquí trabajamos cómo te hablas, la culpa que cargas, lo que te cuesta perdonarte, quién eres cuando nadie te está mirando y qué valores quieres que guíen tus decisiones.',
    topics: ['Autoaceptación', 'Culpa', 'Perdón', 'Diálogo interno', 'Valores', 'Identidad', 'Vulnerabilidad', 'Emociones'],
  },
  {
    id: 'tu-con-otros',
    title: 'Tú con otros',
    text: 'Casi todo lo que duele pasa en relación con alguien. Trabajamos comunicación, límites, conflictos que se repiten, patrones que vienen de lejos, y la responsabilidad que sí te toca y la que no.',
    topics: ['Pareja', 'Comunicación', 'Límites', 'Conflictos', 'Patrones relacionales', 'Conexión', 'Responsabilidad'],
  },
  {
    id: 'tu-frente-a-la-vida',
    title: 'Tú frente a la vida',
    text: 'Cambios que no elegiste, pérdidas, un estrés que no baja, una etapa que se cerró antes de tiempo. Aquí hay espacio para procesarlo sin apurarte.',
    topics: ['Cambios', 'Pérdidas', 'Estrés', 'Ansiedad', 'Transiciones', 'Burnout', 'Experiencias difíciles'],
  },
];
---

<Base
  title="Psicoterapia individual para adultos en Puerto Rico · Growing Souls"
  description="Ansiedad, estrés, culpa, límites, pérdidas y transiciones. Terapia individual presencial y en línea con la Dra. Melanie Acevedo Vélez."
>
  <PageHero
    eyebrow="Terapia individual"
    title="Lo que traes no tiene que tener nombre todavía."
    subtitle="Empezamos por lo que sientes. El nombre, si hace falta, llega después."
  />

  <section class="section section--tight">
    <div class="container universos">
      {
        universos.map((u, i) => (
          <article class="universo" id={u.id} data-reveal style={`--reveal-index: ${i}`}>
            <h2 class="universo__title">{u.title}</h2>
            <p class="universo__text">{u.text}</p>
            <ul class="universo__topics" role="list" data-dotlist>
              {u.topics.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--sand">
    <div class="container--narrow prose" data-reveal>
      <p class="eyebrow">También puedes llegar buscando ayuda con</p>
      <p>
        <Verify note="Revisión clínica: dejar solo lo que Melanie trabaja">
          ansiedad, estrés, duelo, burnout, transiciones de vida, baja autoestima y dificultades en las relaciones.
        </Verify>
      </p>
      <h2>Cómo empezar</h2>
      <ol>
        <li>Solicitas una cita.</li>
        <li>Coordinamos día, hora y modalidad: presencial o virtual.</li>
        <li>Nos conocemos en la primera sesión, a tu ritmo.</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container libros">
      <div class="libros__figure">
        <ArchPhoto
          src={fotoLibros}
          alt="Melanie sostiene varios libros de psicología y sonríe"
          focus="50% 0%"
          ratio="2 / 3"
          fill="sand"
          sizes="(min-width: 960px) 34vw, (min-width: 640px) 60vw, 100vw"
        />
      </div>
      <div class="libros__text" data-reveal style="--reveal-index: 1">
        <p class="eyebrow">Evidencia y humanidad</p>
        <h2>La evidencia da estructura. La humanidad da conexión.</h2>
        <p>
          Cada herramienta que trabajamos tiene respaldo científico. Y cada sesión tiene algo que ningún manual
          incluye: alguien que te escucha con respeto, sin apurarte y sin decidir por ti.
        </p>
      </div>
    </div>
  </section>

  <CtaBand title="Tal vez llevas algún tiempo pensando en comenzar." subtitle="Cuando sientas que es el momento de hablar, aquí hay un espacio para escucharte." tone="sand" />
</Base>

<style>
  .universos {
    display: grid;
    gap: var(--space-4);
  }
  .universo {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-top: 1px solid var(--olive);
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }
  .universo__title {
    font-style: italic;
  }
  .universo__text {
    max-width: var(--measure);
  }
  /* Lista corrida separada por puntos medios: la misma pieza que en la portada. */
  .universo__topics {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.35rem;
    padding: 0;
    max-width: 28rem;
    font-family: var(--font-serif);
    font-size: calc(var(--step-body) * 1.1);
    line-height: 1.35;
  }
  /* El separador va en posición absoluta sobre el hueco: mostrarlo u ocultarlo nunca reacomoda la línea. */
  .universo__topics li {
    position: relative;
    white-space: nowrap;
    padding-inline: 0.6em;
  }
  .universo__topics li:not(:first-child)::before {
    content: '·';
    position: absolute;
    left: 0;
    top: 0;
    transform: translateX(-50%);
    color: var(--olive);
  }
  .universo__topics li.is-line-start::before {
    display: none;
  }
  .libros {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .libros__figure {
    width: min(100%, 22rem);
    margin-inline: auto;
  }
  .libros__text {
    display: grid;
    gap: var(--space-3);
  }
  .libros__text p:last-child {
    max-width: var(--measure);
  }
  @media (max-width: 959px) {
    .universo {
      justify-items: center;
      text-align: center;
    }
    .universo__topics {
      justify-content: center;
      margin-inline: auto;
    }
    .libros__text {
      justify-items: center;
      text-align: center;
    }
    .libros__text p:last-child {
      margin-inline: auto;
    }
  }
  @media (min-width: 960px) {
    .universos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
    .libros {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
    .libros__figure {
      width: min(100%, 26rem);
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isPreview } from '../data/site';

interface Props {
  numeral: string;
  title: string;
  id: string;
  image?: ImageMetadata;
  alt?: string;
  /** Sin copy aprobado: en vista previa se muestra como "en preparación"; en producción no se renderiza. */
  pending?: string;
}
const { numeral, title, id, image, alt = '', pending } = Astro.props;
const hasBody = Astro.slots.has('default');
const render = hasBody || (pending && isPreview);
---

{
  render && (
    <article class="chapter" id={id}>
      <header class="chapter__head" data-reveal>
        <p class="chapter__numeral">Capítulo {numeral}</p>
        <h2 class="chapter__title">{title}</h2>
      </header>
      {image && (
        <figure class="chapter__figure" data-reveal>
          <Image
            src={image}
            alt={alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 960px) 40vw, 100vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
        </figure>
      )}
      <div class="chapter__body prose" data-reveal style="--reveal-index: 1">
        {hasBody ? (
          <slot />
        ) : (
          <p class="chapter__pending" data-verify={`Entrevista: ${pending}`} title={`Pendiente: ${pending}`}>
            Capítulo en preparación. {pending}
          </p>
        )}
      </div>
    </article>
  )
}

<style>
  .chapter {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }
  .chapter__head {
    display: grid;
    gap: var(--space-2);
  }
  .chapter__numeral {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--olive-deep);
    font-size: calc(var(--step-body) * 1.1);
  }
  .chapter__title {
    max-width: 20ch;
  }
  .chapter__figure {
    margin: 0;
  }
  .chapter__figure :global(img) {
    width: 100%;
    max-width: 34rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: var(--radius);
  }
  .chapter__pending {
    font-style: italic;
    color: var(--fg-soft);
  }
  @media (min-width: 960px) {
    .chapter {
      grid-template-columns: 1fr 1.6fr;
      column-gap: var(--space-8);
    }
    .chapter__head {
      grid-column: 1;
    }
    .chapter__figure {
      grid-column: 1;
      grid-row: 2;
    }
    .chapter__body {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>

---
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import ArchPhoto from './ArchPhoto.astro';

/**
 * Hero de portada. Una sola foto (el arco) en todos los tamaños:
 * en móvil va primero, con su pie, y el texto debajo; en tablet, texto y arco apilados y centrados;
 * en desktop, dos mitades iguales con el texto a la izquierda.
 */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  signature?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  image: ImageMetadata;
  alt: string;
  caption?: string;
  /** Posición del recorte, p. ej. "50% 30%" */
  focus?: string;
}
const { eyebrow, title, subtitle, signature, primary, secondary, image, alt, caption, focus = '50% 30%' } = Astro.props;
---

<section class="hero">
  <div class="hero__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      signature && (
        <p class="hero__signature">
          {signature.split(' · ').map((part, i) => (
            <span class:list={['hero__sig', { 'hero__sig--name': i === 0 }]}>{part}</span>
          ))}
        </p>
      )
    }
    {
      (primary || secondary) && (
        <div class="hero__actions">
          {primary && (
            <Button href={primary.href} variant="primary">
              {primary.label}
            </Button>
          )}
          {secondary && (
            <Button href={secondary.href} variant="secondary">
              {secondary.label}
            </Button>
          )}
        </div>
      )
    }
  </div>

  <div class="hero__photo">
    <ArchPhoto
      src={image}
      alt={alt}
      loading="eager"
      focus={focus}
      caption={caption}
      sizes="(min-width: 960px) 40vw, (min-width: 640px) 416px, 336px"
    />
  </div>
</section>

<style>
  /* Móvil (< 640 px): la foto primero, centrada, y el texto debajo. Lo primero que se ve es a Melanie. */
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-4);
    padding-inline: var(--gutter);
    justify-items: center;
    text-align: center;
  }
  .hero__photo {
    order: -1;
    width: min(100%, 21.5rem);
  }
  .hero__text {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    max-width: 36rem;
  }
  .hero__title {
    font-size: var(--step-h1);
    max-width: 18ch;
  }
  .hero__subtitle {
    font-size: calc(var(--step-body) * 1.1);
    max-width: 32ch;
  }
  .hero__signature {
    font-size: var(--step-small);
    letter-spacing: 0.05em;
    color: var(--fg-soft);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.6ch;
    row-gap: 0.15rem;
  }
  .hero__sig--name {
    flex-basis: 100%;
    color: var(--fg);
  }
  .hero__sig:not(.hero__sig--name):not(:last-child)::after {
    content: '·';
    margin-left: 0.6ch;
    color: var(--olive);
  }
  /* Dos botones del mismo ancho, apilados y centrados en móvil. */
  .hero__actions {
    display: grid;
    gap: var(--space-2);
    width: min(100%, 20rem);
    margin-top: var(--space-1);
  }
  .hero__actions :global(.btn) {
    width: 100%;
  }
  /* En móvil el pie de foto ya dice nombre y título: la firma se omite para no repetirlo. */
  @media (max-width: 639px) {
    .hero__signature {
      display: none;
    }
  }

  /* Tablet (640 a 959 px): texto arriba y arco debajo, todo centrado. */
  @media (min-width: 640px) {
    .hero {
      gap: var(--space-6);
      padding-top: clamp(1.5rem, 5vh, 3rem);
    }
    .hero__photo {
      order: 0;
      width: min(100%, 26rem);
    }
    .hero__title,
    .hero__subtitle {
      margin-inline: auto;
    }
    .hero__actions {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      width: auto;
      justify-content: center;
    }
    .hero__actions :global(.btn) {
      width: auto;
    }
  }

  /* Desktop: dos mitades iguales, texto centrado en vertical, arco centrado en su mitad. */
  @media (min-width: 960px) {
    .hero {
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
      padding: var(--space-6) 0 var(--space-8);
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: clamp(2rem, 6vw, 6rem);
      text-align: left;
      justify-items: stretch;
      min-height: calc(100vh - var(--nav-height));
      align-content: center;
    }
    .hero__text {
      max-width: 34rem;
      margin-inline: 0;
      justify-items: start;
      text-align: left;
    }
    .hero__title {
      max-width: 15ch;
    }
    .hero__signature {
      justify-content: flex-start;
    }
    .hero__title,
    .hero__subtitle,
    .hero__signature {
      margin-inline: 0;
    }
    .hero__actions {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      width: auto;
    }
    .hero__actions :global(.btn) {
      width: auto;
    }
    .hero__photo {
      width: min(100%, 33rem);
      justify-self: center;
    }
  }
</style>
